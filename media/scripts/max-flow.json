{
  "algorithmId": "max-flow",
  "pronunciations": {
    "Dinic": "迪尼克"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "城市供水的最窄管段",
      "text": "一条供水路线能再送多少，由最窄剩余管段决定。多条路线不能超容量，内部流入等于流出，目标是总输送量最大。",
      "ruleIds": [
        "max-flow.initialize"
      ],
      "panelExplanations": [
        "一条路线三段容量4、1、4，中间最窄处限制整条路线。",
        "本次最多增送min(4,1,4)=1；入口大不能消除中途瓶颈。",
        "正向余量减1、反向记录加1。反向是撤回旧分配的权限，不是新水管。"
      ]
    },
    {
      "id": "residual",
      "kind": "event",
      "title": "正向可加，反向可撤回",
      "text": "正向余量是还能增加多少，反向余量是能撤回多少旧分配，初始为零。反向不是新水管，它让早先安排能够调整。",
      "ruleIds": [
        "max-flow.initialize"
      ],
      "eventIds": [
        "0"
      ]
    },
