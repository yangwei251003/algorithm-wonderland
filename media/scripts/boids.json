{
  "algorithmId": "boids",
  "pronunciations": {
    "Boids": "鸟群模型"
  },
  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "没有领队，为什么也能结伴前进",
      "text": "和朋友一起走路时，你会避开太近的人、跟上大家的方向、别离伙伴太远。每个人只看附近，队伍却能形成整体。这就是鸟群模型的启发：局部小规则反复作用，不需要给每只鸟预先画一条完整路线。",
      "ruleIds": [
        "boids-force"
      ],
      "panelExplanations": [
        "每个人读取同一时刻的近邻信息，再一起移动。",
        "太近就分离；朝向不同时向邻居平均速度调整。",
        "离群时朝邻居平均位置靠拢；无需全局领队。"
      ]
    },
    {
      "id": "neighbors",
      "kind": "event",
      "title": "先确定谁算邻居",
      "text": "本例二十只鸟，只看普通平面距离小于二十二、又没有完全重合的邻居。距离小于九时增加分离作用，靠拢指向邻居平均位置，对齐朝向平均速度；没有邻居时，靠拢和对齐都为零。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "boids-force"
      ],
      "pageModes": [
        "rule",
        "comparison"
      ],
      "candidateTargets": [
        "鸟3",
        "鸟4"
      ]
    },
    {
      "id": "force",
      "kind": "event",
      "title": "四种作用为什么合成这个方向",
      "text": "第一只鸟有两个邻居，横向分离为零，靠拢约零点零二一，对齐约负零点零五三，避障约零点二六九。加起来约零点二三七。方向由这些向量合成，不是为了追随一只隐藏的领头鸟。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "boids-force"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "分离x",
        "靠拢x",
        "对齐x",
        "避障x"
      ],
      "operandsPerPage": 4,
      "detailEventIds": [
        "0"
      ]
    },
    {
      "id": "limit",
      "kind": "event",
      "title": "转向有限，不能瞬间照单全收",
      "text": "横向合力超过每轴零点一八的限制，所以先截到零点一八，再加到旧速度。第一只鸟新横速度约零点八八五，横位置从六十点一一零变成六十点九九五。所有鸟读旧状态后，一起更新。",
      "eventIds": [
        "1"
      ],
      "ruleIds": [
        "boids-move"
      ],
      "pageModes": [
        "calculation"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "speed",
      "kind": "comparison",
      "title": "限速与边界也属于规则",
      "text": "速度过大就按比例缩短到一点六；太小时加一点固定推力。位置越过一百会从另一侧出现，但本教学版判断邻居仍用普通距离，没有把边界两侧当成紧邻。改变这个约定，会得到不同群体行为。",
      "eventIds": [
        "1"
      ],
      "ruleIds": [
        "boids-move"
      ],
      "pageModes": [
        "rule"
      ],
      "detailEventIds": [
        "1"
      ]
    },
    {
      "id": "repeat",
      "kind": "recap",
      "title": "同规则重复：群体形态逐渐出现",
      "text": "剩余同步更新加速回放，每轮重新找邻居、合成作用、限力限速再移动。调高分离通常让个体更分散，调高靠拢会增强聚集倾向，但还受对齐、避障和初始状态共同影响，不能只凭一个滑块断言结局。",
