        "22",
        "23",
        "24"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "finish",
      "kind": "summary",
      "title": "每一步去向都有理由",
      "text": "记住枚举问题、比较混杂度、分裂或停止，再沿分支预测。适合规则梳理和可解释分类；更深可能记住噪声，局部最优分裂不保证整棵树最好。",
      "ruleIds": [
        "decision-tree.compare",
        "decision-tree.split",
        "decision-tree.predict"
      ],
      "visualExplanation": "漫画用水果问题展示树结构；正式案例只有一个横坐标门槛，两片纯叶子。"
    }
  ]
