{
  "algorithmId": "decision-tree",
  "pronunciations": {
    "Gini": "基尼混杂度",
    "CART": "分类决策树"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "设计一串能分清水果的问题",
      "text": "分拣员想把水果分成两类，先问一个能把它们分开的问题，再对每堆继续提问。决策树比较问题能让每堆多纯；生活图里的颜色问题，只是这个思想的类比。",
      "ruleIds": [
        "decision-tree.initialize"
      ],
      "visualExplanation": "问题对应特征门槛，分支对应判断，叶子对应类别；下文正式数据使用横纵坐标。"
    },
    {
      "id": "init",
      "kind": "event",
      "title": "问题从哪些门槛里选",
      "text": "本例取相邻不同坐标的中点，先横向再纵向；并列保留先到候选。八个训练点，两类各四个。",
      "ruleIds": [
        "decision-tree.initialize"
      ],
      "eventIds": [
        "0"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "impurity",
      "kind": "event",
      "title": "混在一起有多乱",
      "text": "基尼混杂度等于二乘类别比例，再乘一减比例。两类各半，得到零点五；全为一类时为零。",
      "ruleIds": [
        "decision-tree.stop"
      ],
      "eventIds": [
        "1"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "first",
      "kind": "event",
      "title": "人数多的一边权重也更大",
      "text": "横坐标十九分成一件和七件。左右混杂度按人数加权，约零点四二九。不能把大小两堆简单平均。",
      "ruleIds": [
        "decision-tree.compare"
      ],
      "eventIds": [
        "2"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "improve",
      "kind": "event",
      "title": "每个候选重新计算",
      "text": "接着试二十二和二十七，混杂度逐步下降。这里只更新暂存最好，尚未正式分裂。",
      "ruleIds": [
        "decision-tree.compare"
      ],
      "eventIds": [
        "3",
        "4"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "perfect",
      "kind": "event",
      "title": "五十为何成为当前最好",
      "text": "门槛五十分成四件和四件。两边各自都是一类，两边混杂度为零，加权结果也是零。",
      "ruleIds": [
        "decision-tree.compare"
      ],
      "eventIds": [
        "5"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "worse",
      "kind": "event",
      "title": "更靠右不一定更好",
      "text": "门槛七十一把一件橙色放进绿色堆，加权混杂度变零点二。比零更差，因此拒绝。",
      "ruleIds": [
        "decision-tree.compare"
      ],
      "eventIds": [
        "6"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "comparison"
      ]
    },
    {
      "id": "tie",
      "kind": "event",
      "title": "一样纯，按什么决定",
      "text": "纵坐标四十六也得到零。没有严格改善，就保留先检查的横坐标五十；这是明确的并列约定。",
      "ruleIds": [
        "decision-tree.compare"
      ],
      "eventIds": [
        "12"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "comparison"
      ]
    },
    {
      "id": "split",
      "kind": "event",
      "title": "选定门槛，再检查子堆",
      "text": "正式以五十划分。分别检查左右四件，已经纯净，于是成为叶子，不必长满深度上限。",
      "ruleIds": [
        "decision-tree.split",
        "decision-tree.stop"
      ],
      "eventIds": [
        "16",
        "17",
        "18",
        "19",
        "20"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "left",
      "kind": "event",
      "title": "第一件新样本走左边",
      "text": "验证样本横坐标十二，小于五十，走左叶；叶子绿色占全部，预测绿色。验证标签没有参与训练。",
      "ruleIds": [
        "decision-tree.predict"
      ],
      "eventIds": [
        "21",
        "22"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "right",
      "kind": "event",
      "title": "第二件沿同一个问题走右边",
      "text": "另一验证样本横坐标八十，不小于五十，走右叶，预测橙色。预测只沿学好的树，不再挑门槛。",
      "ruleIds": [
        "decision-tree.predict"
      ],
      "eventIds": [
        "23",
        "24"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "recap",
      "kind": "recap",
      "title": "完整记录加速回放",
      "text": "回放全部候选与两次预测。未逐个展开的门槛同样经过计算；本版没有额外剪枝。",
      "ruleIds": [
        "decision-tree.initialize",
        "decision-tree.compare",
        "decision-tree.split",
        "decision-tree.stop",
        "decision-tree.predict"
      ],
      "eventIds": [
        "0",
