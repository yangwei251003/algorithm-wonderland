{
  "algorithmId": "logistic-regression",
  "pronunciations": {
    "sigmoid": "西格莫伊德函数"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "给分拣机调三只旋钮",
      "text": "分拣机用宽和高猜类别，两只权重控制特征影响，偏置控制基础分数。合成分数，再转成概率，训练负责调整旋钮。",
      "ruleIds": [
        "logistic-regression.initialize"
      ]
    },
    {
      "id": "init",
      "kind": "event",
      "title": "先缩放，再留出验收样本",
      "text": "两个特征先减五十、再除四十。十点中留两点验证，八点训练。初始权重全零，概率都是一半；每轮看完全部训练点才更新。",
      "eventIds": [
        "0",
        "1"
      ],
      "ruleIds": [
        "logistic-regression.initialize",
        "logistic-regression.gradient"
      ]
    },
    {
      "id": "error",
      "kind": "event",
      "title": "先算概率与真实标签的差",
      "text": "第一件训练品标签零，概率却是一半。概率减标签得到零点五，也是偏置的梯度贡献。",
      "eventIds": [
        "2"
      ],
      "ruleIds": [
        "logistic-regression.gradient"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ],
      "calculationKeys": [
        "p",
        "label",
        "error"
      ]
    },
    {
      "id": "gradient",
      "kind": "event",
      "title": "特征把误差变成调整方向",
      "text": "横向特征缩放后负零点八，乘误差零点五，横向贡献负零点四。纵向同理乘对应特征，得到负零点三二五。",
      "eventIds": [
        "2"
      ],
      "ruleIds": [
        "logistic-regression.gradient"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "x",
        "error",
        "gx",
        "gy"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "batch",
      "kind": "recap",
      "title": "第1轮其余7件，逐个累计",
      "text": "其余七件沿用同一规则，各自贡献偏置和两个特征的梯度。先逐项累加，再除以训练件数八，才得到平均梯度。",
      "eventIds": [
        "3",
        "4",
        "5",
        "6",
        "7",
        "8",
        "9"
      ],
      "ruleIds": [
        "logistic-regression.gradient"
      ]
    },
    {
      "id": "bias",
      "kind": "event",
      "title": "偏置平均梯度为零",
      "text": "偏置累计梯度零，除以八仍为零；从旧值减去学习率乘梯度，偏置保持零。",
      "eventIds": [
        "10"
      ],
      "ruleIds": [
        "logistic-regression.update"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "weight-x",
      "kind": "event",
      "title": "减去负梯度，横向权重增大",
      "text": "横向累计梯度负二点六二五，除以八再乘零点五；从旧值零中减去，得到约零点一六四。减去负数意味着增加。",
      "eventIds": [
        "11"
      ],
      "ruleIds": [
        "logistic-regression.update"
      ],
      "pageModes": [
        "calculation"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "weight-y",
      "kind": "event",
      "title": "纵向权重按同一规则更新",
      "text": "纵向累计梯度负二点二五，也除以八再乘零点五。从旧值零中减去，得到零点一四零六二五。",
      "eventIds": [
        "12"
      ],
      "ruleIds": [
        "logistic-regression.update"
      ],
      "pageModes": [
        "calculation"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "repeat",
