{
  "algorithmId": "hungarian",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "看全队总账，不让人抢岗",
      "text": "三人分三任务，每人一项，每项一人，总工时要最少。抢最省时的岗位会冲突，用比较账探索换岗。",
      "ruleIds": [
        "hungarian.initialize"
      ],
      "panelExplanations": [
        "甲乙丙对应三行，任务对应三列；每人一项，每项一人，比较全队工时之和。",
        "任务有人占用时，沿旧队员继续寻找安排；探索不等于已经换岗。",
        "行势与列势只是比较基准。8−8−0=0是余量，原工时仍为8。"
      ]
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "原工时不变，另建比较账",
      "text": "行势、列势初始为零；余量就是原工时减行势、再减列势。",
      "ruleIds": [
        "hungarian.initialize",
        "hungarian.reduced"
      ],
      "eventIds": [
        "0",
        "1",
        "2"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
