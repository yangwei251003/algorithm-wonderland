  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "四角的小坡面，怎样接成自然地形",
      "text": "想象方格四角各有一张倾斜小坡面，告诉附近位置应该偏高还是偏低。把四角意见柔和地调和，再叠一层更细更弱的起伏，就能生成自然纹理。柏林噪声使用相关的局部规则，不是让每个像素独立掷骰子。",
      "ruleIds": [
        "perlin-gradient"
      ],
      "panelExplanations": [
        "相邻位置共享角点的意见，不是每个像素独立掷骰子。",
        "梯度方向与角点到采样点的位移共同决定点积。",
        "平滑地混合这些影响；坡面是几何类比，不是真实山脉。"
      ]
    },
    {
      "id": "gradient",
      "kind": "event",
      "title": "共享角点，让相邻格有关联",
      "text": "固定种子先打乱一个置换表，给每个角点确定梯度方向。相邻方格共用边上的角点，因此不会各说各话。角点到查询点的位移，与梯度做点积，得到四份带正负的影响；它们不是四个随机亮度。",
      "eventIds": [
