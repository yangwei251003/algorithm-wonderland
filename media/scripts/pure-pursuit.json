{
  "algorithmId": "pure-pursuit",
  "pronunciations": {
    "Pure Pursuit": "纯追踪"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "路线已经有了，怎样沿着它开？",
      "text": "骑车过弯，眼睛看向前方。纯追踪也是这样：在已有路线中选一个前视点，算出车轮该转多少，前进一小段，再选新的点。它跟踪既有路线，不负责寻路或避障。",
      "ruleIds": [
        "pursuit-target",
        "pursuit-steer",
        "pursuit-motion"
      ],
      "panelExplanations": [
        "路线已给定；先选前方的路点作为引导目标。",
        "几何公式给出车轮转角；车身不会瞬间转同样角度。",
        "前进一小段，再根据新位置选点。它不负责寻路和避障。"
      ]
    },
    {
      "id": "target",
      "kind": "event",
      "title": "前视点怎么选出来？",
      "text": "本版先从上次编号向前检查最多十二个路点，找附近最近的位置，再沿路线向前找首个距离达到前视阈值的路点。阈值设为十二，本次选中的实际距离约十三点五七六，因为路线由离散点组成。",
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "compare",
      "kind": "comparison",
      "title": "为什么不追脚下最近那个点？",
      "text": "最近位置帮助判断走到路线哪一段，前视点则负责引导方向，它们不是同一个角色。阈值也不是实际目标距离；把十二直接塞进转向公式，会改变这一次的真实计算。",
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "calculation"
      ],
      "detailEventIds": [
        "0"
      ],
      "calculationKeys": [
        "最近路点",
        "前视编号",
        "前视阈值"
      ]
    },
    {
      "id": "steer",
      "kind": "event",
      "title": "由方向差得到车轮转角",
      "text": "车身方向与目标方向相差约二十七点八八度。用它的正弦乘两倍轴距，再除以实际前视距离，取反正切。本例轴距四，得到车轮转角约十五点四一度。数值计算使用弧度，画面换成度方便阅读。",
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "motion",
      "kind": "event",
      "title": "车轮转了，车身怎样逐渐响应？",
      "text": "十五点四一度是车轮转角，车身不会瞬间转这么多。本次速度四，经过零点一秒，先按简化车辆模型更新朝向，再沿新朝向移动。横坐标从五变到约五点四，纵坐标也产生小变化。",
      "eventIds": [
        "2"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "next",
      "kind": "recap",
      "title": "第2—3步：同规则重新选点",
      "text": "下一步仍重新选点、算转角、更新运动。这两步仍选第九个路点；继续前进，才会换点。",
      "eventIds": [
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ]
    },
    {
      "id": "repeat",
      "kind": "recap",
      "title": "重复选点、转向、前进",
      "text": "加速回放后续规则，全部计算可展开。前视距离、速度和弯道形状共同影响轨迹。较长前视可能更平顺，也可能切过弯道；平顺本身不是误差更小的证据。",
