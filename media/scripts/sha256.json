    {
      "id": "intro-box",
      "kind": "analogy",
      "title": "先分箱：固定大小的输入",
      "text": "像流水线：先把消息变成字节，补齐分箱。",
      "artworkRegion": [
        0.01,
        0.085,
        0.99,
        0.342
      ],
      "panelExplanations": [
        "文本 → UTF-8 字节 → 填充后的 512 位消息块。"
      ],
      "ruleIds": [
        "sha256-bytes",
        "sha256-output"
      ]
    },
    {
      "id": "intro-work",
      "kind": "analogy",
      "title": "固定配方：同样的输入，同样的结果",
      "text": "每箱让八个状态字，按固定配方交接六十四轮。",
      "artworkRegion": [
        0.01,
        0.355,
        0.99,
        0.65
      ],
      "panelExplanations": [
        "a—h 各 32 位；64 轮规则确定，不是随机搅拌。"
      ],
      "ruleIds": [
        "sha256-bytes",
        "sha256-output"
      ]
    },
    {
      "id": "intro-output",
      "kind": "analogy",
      "title": "输出指纹：固定二百五十六位",
      "text": "最后拼成固定长度的指纹。这不是加密。",
      "artworkRegion": [
        0.01,
        0.662,
        0.99,
        0.885
      ],
      "panelExplanations": [
        "八个状态字按顺序连接：8 × 32 = 256 位。"
      ],
      "ruleIds": [
        "sha256-bytes",
        "sha256-output"
      ]
    },
