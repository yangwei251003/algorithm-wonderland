{
  "algorithmId": "mcts",
  "pronunciations": {
    "MCTS": "蒙特卡洛树搜索",
    "UCT": "优西提"
  },
  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "把有限试走次数用在关键岔路",
      "text": "没时间走遍所有未来，就先试几趟，把次数留给有希望、或没试够的岔路。选择、扩展、模拟、回传，循环使用有限预算。",
      "ruleIds": [
        "mcts-select",
        "mcts-expand",
        "mcts-rollout",
        "mcts-backup"
      ],
      "panelExplanations": [
        "有限预算：试走未来，积累证据。",
        "选择已有节点 → 扩展一条尚未试过的分支。",
        "随机模拟 → 沿实际经过路径回传得分。"
      ]
    },
    {
      "id": "start",
      "title": "从根开始",
      "text": "本例轮到叉，预算四十次模拟。从根出发，先看看哪些动作还没试过。",
      "kind": "event",
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "expand",
      "title": "从未试动作里抽一格",
      "text": "五个未试空格是三、六、七、八、九。索引从零数，随机数约零点六零一乘五向下取整是三，对应第八格。只建立这个新节点。",
      "kind": "event",
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "rollout",
      "title": "随机走完，不假装最佳应对",
      "text": "接着圈从四个空格随机选，零点四四八乘四向下取整是一，对应第六格。落圈后连成一行，立刻停止；模拟不假设每手最优。",
      "kind": "event",
      "eventIds": [
        "2"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "backup",
      "title": "一个样本沿祖先记账",
      "text": "叉输，这次样本得零。沿新节点到根，访问各加一，得分各加零。胜一、和半分、负零，始终按根玩家记账；不在路径上的节点不变。",
      "kind": "event",
      "eventIds": [
        "3"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "initial",
      "title": "同规则试其余动作",
      "text": "同规则回放到第五次结束。其他根动作各试一次。平均得分是累计得分除以次数，一次好运不能证明最好。",
      "kind": "recap",
      "eventIds": [
        "4",
        "5",
        "6",
        "7",
        "8",
        "9",
        "10",
        "11",
        "12",
