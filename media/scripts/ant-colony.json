    },
    {
      "id": "evaporate",
      "kind": "event",
      "title": "先让所有旧信号褪色",
      "text": "整轮结束，所有旧信息素统一乘零点七五，本例一变零点七五。蒸发减弱偏好，不会缩短道路，也不把未中边清零。",
      "ruleIds": [
        "ant-colony.evaporate",
        "ant-colony.deposit"
