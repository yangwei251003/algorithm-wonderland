{
  "algorithmId": "ant-colony",
  "pronunciations": {
    "ACS": "蚁群系统"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "留下会淡去的路标",
      "text": "蚂蚁留下会淡去的路标，伙伴结合记号和距离选择下一城。走完短路线，留下更多记号；旧记号先褪色，减少对旧选择的依赖。这是算法类比，不是昆虫行为全貌。",
      "ruleIds": [
        "ant-colony.initialize",
        "ant-colony.deposit"
      ],
      "panelExplanations": [
        "路标强度与距离共同决定权重，只去未访问城市。漫画距离6和3仅为类比，不冒充本例数据。",
        "整条闭环越短，每条经过边获得的新增记号越多；需要走回起点才能评价。",
        "每轮所有旧记号先蒸发，再由所有蚂蚁沿各自完整路线补充，不只冠军留信号。"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "先规定本版规则",
      "text": "本例四城、三只蚂蚁、五轮，初始信息素为一。只在未访问城市中选择。权重是信息素除以距离平方，再除以所有候选权重之和，变成概率。",
      "ruleIds": [
        "ant-colony.initialize",
        "ant-colony.choose"
      ],
      "eventIds": [
        "0",
        "1"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "choose",
      "kind": "event",
      "title": "抽签落在哪一段就去哪里",
      "text": "首步去二、三、四的概率约百分之三十一、十九、五十。抽签约零点七二三，落入四的区间，因此去四。二和三留待后面，不能说它们是坏路线。",
      "ruleIds": [
        "ant-colony.choose"
      ],
      "eventIds": [
        "2"
      ],
      "detailEventIds": [
        "2"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "continue-two",
      "kind": "event",
      "title": "从四出发，选中城市二",
      "text": "到四后再选二。",
      "ruleIds": [
        "ant-colony.choose",
        "ant-colony.evaluate"
      ],
      "eventIds": [
        "3"
      ],
      "detailEventIds": [],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "continue-one",
      "kind": "event",
      "title": "只剩城市三，概率为一",
      "text": "剩下三只有一个候选，概率为一。已访问城市不能重选，直到每城都访问过。",
      "ruleIds": [
        "ant-colony.choose",
        "ant-colony.evaluate"
      ],
      "eventIds": [
        "4"
      ],
      "detailEventIds": [],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "evaluate",
      "kind": "event",
      "title": "回到起点，才能比较整圈",
      "text": "从三回到一，闭环长约一百二十点七九，更新最好记录。必须计入回程，不能只量到达最后一城前的路。",
      "ruleIds": [
        "ant-colony.choose",
        "ant-colony.evaluate"
      ],
      "eventIds": [
        "5"
      ],
      "detailEventIds": [
        "5"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "rare-choice",
      "kind": "event",
      "title": "第二只为什么没选概率最大的",
      "text": "第二只从二出发，去四的概率约七成，却抽到三：随机数落进三的区间。概率最大不等于必选，其他城市只是本步未中。",
      "ruleIds": [
        "ant-colony.choose"
      ],
      "eventIds": [
        "6",
        "7"
      ],
      "detailEventIds": [
        "7"
      ],
      "pageModes": [
        "rule",
        "comparison"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "others",
      "kind": "event",
      "title": "其余完整路线也参与评价",
      "text": "剩余访问遵守相同规则。每只都完成自己的闭环再记录长度；不能在走到一半时就按暂时短路给奖励。",
      "ruleIds": [
        "ant-colony.choose",
        "ant-colony.evaluate"
      ],
      "eventIds": [
        "8",
