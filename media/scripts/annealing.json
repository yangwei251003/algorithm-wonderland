{
  "algorithmId": "annealing",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "允许偶尔下坡的探索者",
      "text": "寻找高峰时，一味上坡可能困在小山。模拟退火允许暂时下坡，用温度控制冒险程度：开始较宽容，后来逐渐谨慎。另记最高峰笔记，即使下降也不忘历史最好。",
      "ruleIds": [
        "annealing.initialize",
        "annealing.remember"
      ],
      "panelExplanations": [
        "高温时对同样损失较宽容；是否接受较差候选仍需抽签。",
        "温度降低后，同样损失的接受概率更小，不代表任意下坡都禁止。",
        "当前位置可以下坡；历史最好另记，只有更高收益才更新。"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "先定目标和温度",
      "text": "本例最大化收益，从位置十五出发，初温二十五，每轮乘零点九七，预算一百六十轮。随机提出合法范围内的邻近候选，用新收益减旧收益来比较。",
      "ruleIds": [
        "annealing.initialize"
      ],
      "eventIds": [
        "0"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "better",
      "kind": "event",
      "title": "提高收益，为什么不用抽接受签",
      "text": "第一次候选收益提高约六点二，直接接受。接受门槛是一，不再抽接受概率；随机提出候选与接受下坡的抽签是两个环节。",
      "ruleIds": [
        "annealing.accept",
        "annealing.remember",
        "annealing.cool"
      ],
      "eventIds": [
        "1"
      ],
      "detailEventIds": [
        "1"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "remember",
      "kind": "event",
      "title": "先记最高点，再降温",
      "text": "这次还超过历史最好，两份位置记录都更新。随后温度二十五乘零点九七，降到二十四点二五。",
      "ruleIds": [
        "annealing.accept",
        "annealing.remember",
        "annealing.cool"
      ],
      "eventIds": [
        "2",
        "3"
      ],
      "detailEventIds": [
        "3"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "down",
      "kind": "event",
      "title": "变差时先算概率，再看抽签",
      "text": "下一次收益下降约三，概率约零点八八三五。抽签零点八五二四七小于概率，因此接受下坡。这不表示差方案更优，而是给探索机会。",
      "ruleIds": [
        "annealing.accept",
        "annealing.remember",
        "annealing.cool"
      ],
      "eventIds": [
        "4"
      ],
      "detailEventIds": [
        "4"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "keep-best",
      "kind": "event",
      "title": "走下坡，为什么不抹掉最高点",
      "text": "当前位置改变，历史最好保留。温度继续乘零点九七；最好记录只在更高收益出现时更新，不能随当前位置一起降低。",
      "ruleIds": [
        "annealing.accept",
        "annealing.remember",
        "annealing.cool"
      ],
      "eventIds": [
        "5",
        "6"
      ],
      "detailEventIds": [
        "5"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "advance",
      "kind": "event",
      "title": "下一次改善后，继续试探",
      "text": "再一次上坡提高收益约七点二二，更新最好并降温，然后才进入下一次候选比较。",
      "ruleIds": [
        "annealing.accept",
        "annealing.remember",
        "annealing.cool"
      ],
      "eventIds": [
        "7",
        "8",
        "9"
      ],
      "detailEventIds": [],
      "pageModes": [
        "compact"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "reject",
      "kind": "event",
      "title": "抽签超过门槛，为什么保持不动",
      "text": "这次收益下降约十七点四七，概率约零点四六五零五，抽签零点五二六五九更大，所以拒绝。当前位置不变，仍继续降温。",
      "ruleIds": [
        "annealing.accept",
        "annealing.cool"
      ],
      "eventIds": [
        "10",
        "11"
      ],
      "detailEventIds": [
        "10"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "cool",
      "kind": "rule",
      "title": "同样损失，低温更谨慎",
      "text": "接受概率来自收益差除以温度后的指数值。同样损失，低温更难接受；同温下，损失越大越难接受。本版用极小温度下限避免除零。",
      "ruleIds": [
        "annealing.accept",
        "annealing.cool"
      ],
      "panelExplanations": [
        "最大化时 Δ=新收益−旧收益。变差时按 p=exp(Δ/T) 计算接受概率，再判断抽签 r 是否小于 p。",
        "固定损失 Δ<0，温度越低，接受概率越小；固定温度，损失越大，接受概率也越小。每次只固定一个条件比较。",
        "接受或拒绝后都继续降温。本版计算概率时用 max(T,0.001) 避免除零；历史最好单独保留。"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "recap",
      "kind": "recap",
      "title": "按同一规则继续探索",
      "text": "回放提案、比较、按需抽签、记最好和降温。",
      "ruleIds": [
        "annealing.initialize",
        "annealing.accept",
        "annealing.remember",
        "annealing.cool",
        "annealing.stop"
      ],
