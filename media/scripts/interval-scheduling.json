        "2"
      ]
    },
    {
      "id": "conflict-six",
      "kind": "event",
      "title": "活动六为何同样拒绝",
      "text": "活动六也是六开始，到十五结束，六仍小于已选末尾十，因此拒绝。这是区间冲突，不是名字靠后或持续较长造成的。",
      "ruleIds": [
        "interval-scheduling.choose"
      ],
      "eventIds": [
        "3"
      ],
      "detailEventIds": [
        "3"
      ]
    },
    {
      "id": "next",
      "kind": "event",
      "title": "十五开始，可以接上",
      "text": "活动一十五开始、二十结束。十五不早于十，二十不超过上限二十五，因此接受，",
      "ruleIds": [
        "interval-scheduling.choose"
      ],
      "eventIds": [
        "4"
      ],
      "detailEventIds": [
        "4"
      ],
      "pageModes": [
        "calculation"
      ],
      "operandsPerPage": 4,
      "stateView": "before"
    },
    {
      "id": "next-write",
      "kind": "event",
      "title": "十五开始，可以接上",
