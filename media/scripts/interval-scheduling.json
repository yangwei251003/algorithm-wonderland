      "ruleIds": [
        "interval-scheduling.choose"
      ],
      "eventIds": [
        "4"
      ],
      "detailEventIds": [
        "4"
      ],
      "pageModes": [
        "comparison"
      ],
      "stateView": "after"
    },
    {
      "id": "late-five",
      "kind": "event",
      "title": "不重叠，仍可能超时",
      "text": "活动五二十一开始，没有重叠，却到二十六才结束，比上限二十五晚，必须拒绝。兼容已选场次与放得进可用时段，是两项独立检查。",
      "ruleIds": [
        "interval-scheduling.choose"
      ],
      "eventIds": [
        "5"
      ],
      "detailEventIds": [
        "5"
      ]
    },
    {
      "id": "late-two",
      "kind": "event",
      "title": "另一个超时活动也拒绝",
      "text": "活动二同样二十一开始，但到二十八结束，也越过二十五的截止。不能只看开始时刻合法，就忽略结束时刻。",
      "ruleIds": [
        "interval-scheduling.choose"
      ],
      "eventIds": [
        "6"
      ],
      "detailEventIds": [
        "6"
      ]
    },
    {
      "id": "proof",
      "kind": "comparison",
      "title": "早结束为什么能保证数量",
      "text": "把某个最优安排的第一场，换成结束更早的可行活动，不会挤掉后续场次。因此总存在最优安排从它开始。选定以后，对剩余时间重复同样理由，得到数量最优。",
      "ruleIds": [],
      "artwork": "../comics/interval-scheduling/summary.png",
      "artworkRegion": [
