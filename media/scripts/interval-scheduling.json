      ],
      "panelExplanations": [
        "交换论证示意（不是本例的活动编号）：把第一场换成结束更早的可行场次，原本能接上的后续场次仍能接上；对剩余时段重复。"
      ]
    },
    {
      "id": "recap",
      "kind": "recap",
      "title": "六次判断，各有原因",
      "text": "完整回放按结束时刻检查，",
