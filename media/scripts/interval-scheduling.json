    {
      "id": "summary",
      "kind": "summary",
      "title": "目标改变，方法也要变",
      "text": "会议室预约和固定时段观看计划可用。活动收入不同，最多场未必收入最高。先确认单一资源、固定时段和最大数量目标，才能沿用最早结束保证。",
      "ruleIds": [
        "interval-scheduling.stop"
      ],
      "panelExplanations": [
        "适用：单一资源、固定时段、最大数量。若每场收入不同，最多场不等于最高收入；清场时间也需加入约束。"
      ],
