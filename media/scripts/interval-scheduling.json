{
  "algorithmId": "interval-scheduling",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "一个场地怎样多办几场",
      "text": "校园只有一个场地，活动时段固定，目标是数量最多。",
      "ruleIds": [
        "interval-scheduling.initialize"
      ],
      "panelExplanations": [
        "单一场地、固定时段，每场同等计数；目标是尽量多安排活动。"
      ],
      "artwork": "../comics/interval-scheduling/analogy.png",
      "artworkRegion": [
        0,
        0.085,
        1,
        0.341
      ]
    },
    {
      "id": "intro-greedy",
      "kind": "analogy",
      "title": "一个场地怎样多办几场",
      "text": "先选结束最早的可行活动，给后面留时间，不是开始最早或持续最短优先。",
      "ruleIds": [
        "interval-scheduling.initialize"
      ],
      "panelExplanations": [
        "先比较结束时间，再检查与已选场次能否相接；不是开始早或时间短就先选。"
      ],
      "artwork": "../comics/interval-scheduling/analogy.png",
      "artworkRegion": [
        0,
        0.348,
        1,
        0.602
      ]
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "先按结束时刻排队",
      "text": "本例时段上限二十五，六场结束时刻排成十、十二、十五、二十、二十六、二十八。每次都检查重叠和是否超出可用时段。",
      "ruleIds": [
        "interval-scheduling.initialize"
      ],
      "eventIds": [
        "0"
      ]
    },
    {
      "id": "choose",
      "kind": "event",
      "title": "第一场为什么接受",
      "text": "活动三从四开始、十结束。四不早于初始可用时刻零，十也不超过上限二十五，所以接受，",
      "ruleIds": [
        "interval-scheduling.choose"
      ],
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ],
      "operandsPerPage": 4,
      "stateView": "before"
    },
    {
      "id": "choose-write",
      "kind": "event",
      "title": "第一场为什么接受",
      "text": "并把上次结束时刻改成十。",
      "ruleIds": [
        "interval-scheduling.choose"
      ],
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "comparison"
      ],
      "stateView": "after"
    },
    {
      "id": "conflict",
      "kind": "event",
      "title": "十二结束也可能冲突",
      "text": "活动四六开始、十二结束，开始六小于已选末尾十，发生重叠，因此拒绝。结束较早还不够，必须与已经选中的场次兼容。",
      "ruleIds": [
        "interval-scheduling.choose"
      ],
      "eventIds": [
        "2"
      ],
