{
  "algorithmId": "potential-field",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "目标吸引，障碍排斥",
      "text": "机器人同时受到几种导航力量：目标把它往目的地拉，附近障碍把它往外推。把这些方向相加，每次向合力走一小步，再重新计算。这里的力是数学向量，不是真实磁力，也没有预先安排好的完整路线。",
      "ruleIds": [
        "potential-force",
        "potential-step"
      ],
      "panelExplanations": [
        "目标产生吸引；近处障碍产生排斥。箭头表示数学向量。",
        "把各股方向相加，向合力走一小步；本版还检查整段碰撞。",
        "位置改变后重新计算。它没有预先规划一整条路线。"
      ]
    },
    {
      "id": "attract",
      "kind": "event",
      "title": "先把目标差距变成吸引",
      "text": "第一步横坐标八，目标九十二，相差八十四。乘零点零六，得到向右的吸引力五点零四。",
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "吸引x",
        "吸引y",
        "合力x"
      ]
    },
    {
      "id": "outside",
      "kind": "comparison",
      "title": "为什么还没有排斥力？",
      "text": "最近障碍边缘距离约十八点七九，在十八的影响范围以外，所以本步不施加排斥。",
      "eventIds": [
        "0"
      ],
      "detailEventIds": [
        "0"
      ],
      "pageModes": [
        "comparison"
      ],
      "candidateTargets": [
        "障碍 1"
      ]
    },
    {
      "id": "move",
      "kind": "event",
      "title": "合力不直接等于位移",
      "text": "合力很大，也不能一步冲到目标。本版把移动长度限制在最多零点八，检查整段线没有碰撞以后，位置才从八变成八点八。若候选运动碰到障碍，就保留原位置；画面不会偷偷穿墙。",
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "approach",
      "kind": "recap",
      "title": "第二次：同规则继续前进",
      "text": "再按相同规则前进一步，重新测量距离。",
      "eventIds": [
        "2",
        "3"
      ]
    },
    {
      "id": "threshold",
      "kind": "comparison",
      "title": "为什么这个障碍开始起作用？",
      "text": "第三次计算，最近障碍边缘距离约十七点三零，进入十八以内，排斥开始参与。其他障碍仍在范围外，本步不参与；它们并没有从地图消失。",
      "eventIds": [
        "4"
      ],
      "detailEventIds": [
        "4"
      ],
      "pageModes": [
        "comparison"
      ],
      "candidateTargets": [
        "障碍 1",
        "障碍 2"
      ]
    },
    {
      "id": "step",
      "kind": "recap",
      "title": "加入排斥，再更新位置",
      "text": "检查新的运动线段，确认可行再更新位置。",
      "eventIds": [
        "5"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "候选x",
        "候选y"
      ]
    },
    {
      "id": "sum",
      "kind": "event",
      "title": "多股方向相加，产生新的小步",
      "text": "排斥的方向远离障碍，大小随距离与设定强度变化。所有分力同时相加，决定下一步方向。靠得很近时，距离最低按零点二计算，避免除以零；每一步仍要检查碰撞。",
      "eventIds": [
        "6"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "repeat",
      "kind": "recap",
      "title": "相同局部规则继续重复",
      "text": "接下来加速回放后续重复计算。每一轮都根据新的位置重新量距离，再合成吸引和排斥。合力变小，步子也会变小，而不是永远走固定长度。全部计算可以逐条展开。",
