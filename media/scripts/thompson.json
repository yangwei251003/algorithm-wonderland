  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "每家摊位都保留一片可能性",
      "text": "还不知道哪家摊位最好，不必钉死一个分数，先保留它可能有多好的分布。每次从各家分布抽一个值，挑最大的去试；观察反馈，只更新试过的摊位。汤普森采样用不确定性安排探索。",
      "ruleIds": [
        "thompson-choose"
      ],
      "panelExplanations": [
        "分布概念示意：每家保留可能成功率，而非一个确定分数。",
        "保留分布 → 独立抽样 → 选抽样最大者。",
        "观察实际反馈，只更新亲自试过的选项。"
      ]
    },
