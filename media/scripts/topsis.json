    {
      "id": "raw",
      "kind": "event",
      "title": "不同单位，先统一尺度",
      "text": "本例比较校园配送、节能助手、视觉检测和教学工具。元、评分、负担系数不能直接相加。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "topsis-normalize"
      ],
      "pageModes": [
        "rule"
      ],
      "stateView": "before",
      "visualFocus": "raw"
    },
    {
      "id": "normalize",
      "kind": "event",
      "title": "不同单位，先统一尺度",
      "text": "每一列先平方求和再开方，用原值除以这个长度。例如配送预算三千九百九十九，归一化后约零点三一八。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "topsis-normalize"
      ],
      "pageModes": [
        "calculation"
      ],
      "stateView": "after",
      "visualFocus": "normalized"
    },
    {
      "id": "weight-input",
      "kind": "event",
      "title": "把重视程度乘进去",
      "text": "预算、价值、负担的原始权重是五、五、四。先除以总和十四，再乘到各列。",
      "eventIds": [
        "1"
      ],
      "ruleIds": [
        "topsis-weight"
      ],
      "pageModes": [
        "calculation"
      ],
      "stateView": "after",
      "visualFocus": "weights"
    },
    {
      "id": "weight",
      "kind": "event",
      "title": "把重视程度乘进去",
      "text": "预算和价值各占十四分之五，负担占十四分之四；零权重会使该指标不影响距离，权重不能为负。",
      "eventIds": [
        "1"
      ],
      "ruleIds": [
        "topsis-weight"
      ],
      "pageModes": [
        "compact"
      ],
      "stateView": "after",
      "visualFocus": "weighted"
    },
    {
      "id": "direction",
      "kind": "event",
      "title": "理想组合未必真的存在",
      "text": "注意方向：价值越大越好，而预算和负担越小越好。",
      "eventIds": [
        "2"
      ],
      "ruleIds": [
        "topsis-ideal"
      ],
      "pageModes": [
        "rule"
      ],
      "stateView": "before",
      "visualFocus": "directions"
    },
    {
      "id": "ideal",
      "kind": "event",
      "title": "理想组合未必真的存在",
      "text": "逐列拿最好值拼成理想点，拿最差值拼成另一点。三种最好属性可以来自不同项目，因此理想点只是比较参照，不一定能直接选择购买。",
      "eventIds": [
        "2"
      ],
      "ruleIds": [
        "topsis-ideal"
      ],
      "pageModes": [
        "calculation"
      ],
      "stateView": "after",
      "visualFocus": "ideal"
    },
    {
      "id": "distance",
      "kind": "event",
      "title": "算到两个参照的距离",
      "text": "逐列算差，平方相加再开方，得到距离。校园配送到理想约零点零七四八，到最差约零点一七六四。",
      "eventIds": [
        "3"
      ],
      "ruleIds": [
        "topsis-distance"
      ],
      "pageModes": [
        "calculation"
      ],
      "stateView": "after",
      "visualFocus": "distances",
      "hideResult": true
    },
    {
      "id": "closeness",
      "kind": "event",
      "title": "算到两个参照的距离",
      "text": "用离最差的距离，除以两段距离之和，得到贴近度约零点七零二。",
      "eventIds": [
        "3"
      ],
      "ruleIds": [
        "topsis-distance"
      ],
      "pageModes": [
        "compact"
      ],
      "stateView": "after",
      "visualFocus": "closeness"
