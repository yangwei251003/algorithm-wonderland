{
  "algorithmId": "ucb",
  "pronunciations": {
    "UCB1": "优西比一",
    "UCB": "优西比"
  },
  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "熟悉的好摊，还是没试够的新摊",
      "text": "逛美食街，既想吃到好摊，又想给陌生摊位机会。UCB把经验均值与探索奖励合成比较分。每轮先比较，再亲自试一家；最初几次好运不代表一直好。反馈到来，只更新这家记录，下一轮重新计算。",
      "ruleIds": [
        "ucb-choose"
      ],
      "panelExplanations": [
        "经验均值与探索奖励一起比较，兼顾收益和证据不足。",
        "每轮比较选择分，再亲自试一家，观察实际反馈。",
        "只更新亲自试过的摊位，下一轮重新计算。"
      ]
    },
    {
      "id": "untried",
      "kind": "event",
      "title": "没试过，先给一次机会",
      "text": "初始三家都未试，选择分设为无穷大。甲乙丙同分，按固定顺序先试甲，另两家等待后续机会。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
