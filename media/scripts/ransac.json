  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "先提一条趋势，再问大家支不支持",
      "text": "观测点混入坏点时，先随机选两个点，提出一条候选趋势。再让全部点按到直线的距离投票，容差内算支持，容差外暂不支持。多次提出并检验，只保留支持更多的当前候选，不强迫所有点同意。",
      "ruleIds": [
        "ransac-sample",
        "ransac-consensus"
      ],
      "panelExplanations": [
        "随机抽少量点提出候选线，尚未证明可靠。",
        "全部点按相同距离门槛检验，记录支持数。",
        "容差内支持、容差外暂不支持；换模型后重新检查。"
      ]
    },
