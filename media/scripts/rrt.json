{
  "algorithmId": "rrt",
  "pronunciations": {
    "RRT": "快速探索随机树"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "让候选路线长成探路树",
      "text": "机器人想绕过障碍。快速探索随机树会抽一个位置，找树上离它最近的节点，试着往那里延伸。树是计算里的候选路线，不是机器人已经走过的轨迹。",
      "ruleIds": [
        "rrt-nearest",
        "rrt-extend"
      ],
      "panelExplanations": [
        "探路树表示计算中的候选路线，机器人还没有实际走过这些枝条。",
        "先随机采样，再比较树中节点到这次样本的距离。",
        "短步延伸后检查整段碰撞。失败就拒绝该枝条，继续采样。"
      ]
    },
    {
      "id": "sample",
      "kind": "event",
      "title": "先选离样本最近的树节点",
      "text": "第一次样本距起点约五十点九七七。树里目前只有起点，所以先选它作为最近节点。",
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "采样x",
        "采样y",
        "已有节点数"
      ]
    },
    {
      "id": "extend",
      "kind": "event",
      "title": "最多延伸七，再检查整段",
      "text": "最大步长是七，所以只朝样本走七，不直接跳过去。整段线无碰撞，新节点才接入树，并记住父节点。",
      "eventIds": [
        "1"
      ],
      "readingHoldSeconds": 4,
      "readingHoldReason": "留出首次规则与代入值的阅读时间；原速配音后保留明确停顿。",
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "距离",
        "步长",
        "缩放"
      ]
    },
    {
      "id": "far",
      "kind": "event",
      "title": "新节点仍不能直达终点",
      "text": "第一个新节点还远离终点，不能直接连接，要继续抽样。",
      "eventIds": [
        "2"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "nearest",
      "kind": "comparison",
      "title": "最近，是相对本次样本",
      "text": "第二次样本距节点一约九点八四七，距节点二约四点九三二，所以从节点二延伸。节点一只是本次更远，仍留在树上。",
      "eventIds": [
        "3"
      ],
      "detailEventIds": [
        "3"
      ],
      "pageModes": [
        "comparison"
      ],
      "candidateTargets": [
        "树节点 1",
        "树节点 2"
      ]
    },
    {
      "id": "short",
      "kind": "event",
      "title": "距离小于步长，走到样本",
      "text": "这次距离小于七，缩放取一，可以直接到达样本。",
      "eventIds": [
        "4"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "距离",
        "步长",
        "缩放"
      ]
    },
    {
      "id": "repeat1",
      "kind": "recap",
      "title": "继续使用相同的选点和延伸规则",
      "text": "同规则加速回放：每次重选最近节点，不是固定从最后节点出发。本版有百分之十二的概率直接向终点采样。",
      "eventIds": [
