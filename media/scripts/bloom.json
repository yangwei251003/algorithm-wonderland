{
  "algorithmId": "bloom",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "共享灯板只记亮没亮",
      "text": "名字按固定规则对应几盏灯。登记只点亮，不记谁点的。必要灯有一盏灭着，肯定没登记；全亮只代表可能。",
      "ruleIds": [
        "bloom.initialize"
      ],
      "panelExplanations": [
        "固定规则把名字映射到多个灯位；只开不关，因此缺一盏能排除，全亮可能是别人点亮。"
      ]
    },
    {
      "id": "init",
      "kind": "event",
      "title": "十六盏灯，三套固定规则",
      "text": "十六位编号零到十五，最初全零。每个键算三次。教学哈希不保证独立，也不是密码哈希。",
      "ruleIds": [
        "bloom.initialize"
      ],
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "hash-init",
      "kind": "event",
      "title": "每套规则从自己的初值开始",
      "text": "先加入a。第一套设置初值，再逐字节混入。不同套规则用不同盐，改变起点。",
      "ruleIds": [
        "bloom.hash"
      ],
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "mix",
      "kind": "event",
      "title": "字节混入，保留低三十二位",
      "text": "a的字节值九十七，与旧值异或，再乘固定系数，保留低三十二位。图中是同一次计算的输入和结果。",
      "ruleIds": [
        "bloom.hash"
      ],
      "eventIds": [
        "2"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "old",
        "byte",
        "xored",
        "multiplier"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "position",
      "kind": "event",
      "title": "对十六取余，得到灯号",
      "text": "哈希对十六取余，余数七就是位置七。只是算地址，还没点灯。",
      "ruleIds": [
        "bloom.hash"
      ],
      "eventIds": [
        "3"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "other-hashes",
      "kind": "recap",
      "title": "另两套重新开始计算",
      "text": "另两套从各自初值开始，重复混入和取余，不能沿用上一套结果。",
      "ruleIds": [
        "bloom.hash"
      ],
      "eventIds": [
        "4",
        "5",
        "6",
        "7",
        "8",
        "9"
      ]
    },
    {
      "id": "insert",
      "kind": "recap",
      "title": "逐个把所需位设为一",
      "text": "地址都算完，再依次点亮七、二、十三。每位只存零或一，不存名字和次数。",
