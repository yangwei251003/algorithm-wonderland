        "16",
        "17",
        "18"
      ],
      "ruleIds": [
        "ahp-power"
      ],
      "stateView": "after",
      "visualFocus": "normalize"
    },
    {
      "id": "transitive",
      "kind": "event",
      "title": "偏好比例是否互相打架",
      "text": "本例二分之一乘四等于二，三组比较相互协调。",
      "eventIds": [
        "19"
      ],
      "ruleIds": [
        "ahp-consistency"
      ],
      "pageModes": [
        "compact"
      ],
      "stateView": "before",
      "visualFocus": "relations",
      "hideResult": true
    },
    {
      "id": "consistency",
      "kind": "event",
      "title": "偏好比例是否互相打架",
      "text": "由矩阵乘权重的比值估计出的特征值为三，一致性比率得到零。超过零点一时建议重审比较；通过检查只能说明协调，不能证明偏好客观正确。",
      "eventIds": [
        "19"
