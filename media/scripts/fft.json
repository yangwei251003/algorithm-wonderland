{
  "algorithmId": "fft",
  "pronunciations": {
    "FFT": "快速傅里叶变换",
    "DFT": "离散傅里叶变换"
  },
  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "混合节奏，怎样分开计账",
      "text": "一段声音可能混着快慢不同的振动。快速傅里叶变换给每个频率算一份复数账目，先按奇偶位置分工；小问题继续拆，算好的结果重复使用；最后校准相位，用加减合成答案，减少重复计算。",
      "ruleIds": [
        "fft-split",
        "fft-butterfly"
      ],
      "panelExplanations": [
        "奇偶下标分工；不是按前后两半切开。",
        "递归拆小问题，复用算过的子结果。",
        "先校准相位，再用同一对子结果相加和相减。"
      ]
    },
    {
      "id": "split",
      "kind": "event",
      "title": "不是切成前后两半",
      "text": "本例一秒采一百二十八点。索引零、二、四这些偶数点一组，一、三、五这些奇数点一组，各六十四点。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "fft-split"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "split-repeat",
      "kind": "recap",
      "title": "同规则重复：继续按子序列奇偶拆分",
      "text": "两组继续按自己的奇偶索引拆分，直到每组只剩一个样本。",
      "eventIds": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "leaf",
      "kind": "event",
      "title": "只剩一个数，就停止拆分",
      "text": "长度一的变换就是样本本身，递归在这里停止。第一个样本为零，另一个是浮点计算产生的近似零；真实记录保留完整精度。",
      "eventIds": [
        "7",
        "8"
      ],
      "ruleIds": [
        "fft-leaf"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "next-pair",
      "kind": "recap",
      "title": "同规则重复：近似零合并，再处理下一对",
      "text": "先合并近似零的一对；再展开下一对子问题，得到负一点五五和一点五五。",
      "eventIds": [
        "9",
        "10",
        "11",
        "12"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "two",
      "kind": "event",
      "title": "加一次、减一次，配出两个结果",
      "text": "现在只看这一对：长度二，旋转因子为一。负一点五五加一点五五得零，相减得负三点一。同一份旋转后的奇分支被用两次，一次加、一次减，这就是蝶形。",
      "eventIds": [
        "13"
      ],
      "ruleIds": [
        "fft-butterfly",
        "fft-split",
        "fft-leaf"
      ],
      "pageModes": [
        "calculation"
      ],
      "detailEventIds": [
        "13"
      ],
      "calculationKeys": [
        "E实",
        "O实",
        "cosθ"
      ]
    },
    {
      "id": "phase-zero",
      "kind": "recap",
      "title": "长度四：先合并索引零",
      "text": "长度四，先合并索引零的这一对近似零。",
      "eventIds": [
        "14"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "phase",
      "kind": "event",
      "title": "为什么还需要旋转相位",
      "text": "再看索引一：奇分支负三点一乘负的虚数单位，旋转成正三点一倍虚数单位；与近似零的偶分支加减，得到正负三点一的虚部。旋转补偿的是奇数采样位置的相位。",
      "eventIds": [
        "15"
      ],
      "ruleIds": [
        "fft-butterfly"
      ],
      "pageModes": [
        "calculation"
      ],
      "detailEventIds": [
        "15"
      ],
      "calculationKeys": [
        "O实",
        "cosθ",
        "sinθ"
      ]
    },
    {
      "id": "repeat",
      "kind": "recap",
      "title": "同规则重复：逐层合并",
      "text": "余下拆分、基例与蝶形按同规则加速回放，最后合并回一百二十八个系数。每次都把同一个旋转后的奇分支，分别加到和减出偶分支；不是只把两条曲线随意拼接。全部真实中间状态都能展开。",
