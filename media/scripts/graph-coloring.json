{
  "algorithmId": "graph-coloring",
  "pronunciations": {
    "DSATUR": "饱和度优先着色"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "不能同时考的科目连起来",
      "text": "考试有共同学生就不能同时考。科目画成点，冲突连边，颜色代表时段。相邻点异色，其余可以复用。饱和度优先法先处理已被最多种邻色限制的考试。",
      "ruleIds": [
        "graph-coloring.initialize"
      ],
      "panelExplanations": [
        "有共同学生的考试连边；颜色代表时段。每条冲突边两端必须异色。",
        "相邻科目分开，无冲突的科目可以复用时段。每次试色都要检查邻居。",
        "饱和度数的是邻居已经使用的不同颜色数，优先处理限制更多的考试。"
      ]
    },
    {
      "id": "saturation",
      "kind": "rule",
      "title": "邻居多，不等于限制颜色多",
      "text": "饱和度数的是已着色邻居用了多少种不同颜色。三个邻居都用同一种色，只封住一个时段；两个邻居分别用两种色，却封住两个。",
      "ruleIds": [
        "graph-coloring.select"
      ],
      "artwork": "../comics/graph-coloring/analogy.png",
      "artworkRegion": [
        0.01,
        0.648,
        0.99,
        0.898
      ],
      "visualExplanation": "三邻居同色 → 饱和度1。\n两邻居异色 → 饱和度2。\n数不同颜色，不数邻居人数。"
    },
    {
      "id": "tie",
      "kind": "rule",
      "title": "并列时，按确定的顺序比较",
      "text": "并列时，本版比较原图连接数，再按小编号选择，不是随机挑一个点。",
      "ruleIds": [
        "graph-coloring.select"
      ],
      "artwork": "../comics/graph-coloring/rules.png",
      "artworkRegion": [
        0.015,
        0.153,
        0.99,
        0.263
      ],
      "visualExplanation": "先比较饱和度；再比较原图度数；仍相同，按小编号。"
    },
    {
      "id": "first",
      "kind": "event",
      "title": "全部无色时如何先选D",
      "text": "开始全部无色，饱和度都是零。节点D连接四个邻居，度数最高，按并列规则先处理它。其他节点仍待安排，不是被删除。",
      "ruleIds": [
        "graph-coloring.initialize",
        "graph-coloring.select",
        "graph-coloring.color"
