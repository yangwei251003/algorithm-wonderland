{
  "algorithmId": "wfc",
  "pronunciations": {
    "WFC": "波函数坍缩",
    "MRV": "最少候选优先",
    "FIFO": "先进先出"
  },
  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "每个位置，先放一叠可能的道路卡",
      "text": "拼道路卡时，每个位置先放一叠可能卡，优先解决选择最少的一叠。定下后，邻居接不上的卡删掉，再传播影响。波函数坍缩靠约束生成图案，名称借自物理，却不是量子模拟。",
      "ruleIds": [
        "wfc-init",
        "wfc-select"
      ],
      "panelExplanations": [
        "先选择最受限制的一叠，再把影响传给邻居。",
        "同格随机未选中的卡仍可能合法；不是证明它不兼容。",
        "只有邻居候选中完全没有兼容支持，才因约束删除。"
      ]
    },
    {
      "id": "domain",
      "kind": "event",
      "title": "候选叠，不是已经铺好的路",
      "text": "本例六乘六格，八种图块用上下左右端口编码。边界不许道路伸出，所以角落只剩两种合法卡。格里多个小图表示可能的候选，不能当作同时铺好的道路。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "wfc-init"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "select-cell",
      "kind": "event",
      "title": "四个最少候选角落，抽到格30",
      "text": "候选最少的四个角落并列，随机抽到编号三十。",
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "select",
      "kind": "event",
      "title": "先选受限的格，再按权重抽卡",
      "text": "它可选空地或上右弯道，权重一和一点二。随机数乘总权重得到约零点九八六，落在空地的第一段区间，所以选空地。",
      "eventIds": [
        "1"
      ],
      "ruleIds": [
        "wfc-select"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "选块随机数",
        "总权重",
        "阈值"
      ],
      "detailEventIds": [
        "1"
      ]
    },
    {
      "id": "select-alternative",
      "kind": "comparison",
      "title": "合法弯道，本次只是没抽中",
      "text": "弯道合法，只是这次没抽中。",
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "comparison"
      ],
      "candidateTargets": [
        "图块3"
      ],
      "detailEventIds": [
        "1"
      ]
    },
    {
      "id": "queue",
      "kind": "event",
      "title": "变化先排队，再影响邻居",
      "text": "把三十排进待办队列，从队首取出。检查按上、右、下、左，外边界忽略。队列只是传播顺序，不保证每圈距离相同。本版按最少候选选格，不用加权香农熵，候选数也不是概率。",
      "eventIds": [
        "2"
      ],
      "ruleIds": [
        "wfc-queue",
        "wfc-select"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "prune",
      "kind": "comparison",
      "title": "没有任何支持，才删掉候选",
      "text": "三十已经是空地，上面二十四格向下开口的卡就无法相接，要删除；不开口的卡保留，四种缩成两种。",
      "eventIds": [
        "3"
      ],
      "ruleIds": [
        "wfc-propagate"
      ],
      "pageModes": [
        "comparison"
      ],
      "candidateTargets": [
        "图块掩码0",
        "图块掩码5"
      ],
      "detailEventIds": [
        "3"
      ]
    },
    {
      "id": "prune-right",
      "kind": "event",
      "title": "右邻格31缩减后也排队",
      "text": "右邻居同样检查，缩减后排进队尾。被删原因是源格没有任何兼容候选，不是仅仅没被抽中。",
      "eventIds": [
        "4"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "next-queue",
      "kind": "event",
      "title": "先出队24，31继续等待",
      "text": "队首先取二十四，三十一等待。",
      "eventIds": [
        "5"
      ],
      "pageModes": [
        "calculation"
      ],
      "detailEventIds": [
        "5"
      ]
    },
    {
      "id": "support",
      "kind": "event",
      "title": "还有一张能支持，就不能删",
      "text": "二十四还有空地与弯道，它上方十八格每张卡都找到匹配支持，因此全部保留，不再次入队。只要求存在支持，不要求源格每种卡都兼容。",
      "eventIds": [
        "6"
      ],
      "ruleIds": [
        "wfc-queue",
        "wfc-propagate"
      ],
      "pageModes": [
        "comparison"
      ],
      "candidateTargets": [
