{
  "algorithmId": "branch-bound",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "先做允许半件的乐观预算",
      "text": "工厂只能做整件，先允许小数，算一份乐观收益。连宽松计划都不如已有整件方案，这支就不用查。分支定界用乐观上界与可行纪录减少搜索。",
      "ruleIds": [
        "branch-bound.initialize",
        "branch-bound.bound"
      ],
      "panelExplanations": [
        "允许小数扩大可行集合，得到乐观上界；已能生产的整数方案才是可行纪录。",
        "图中2.4只是类比：分成至多2和至少3，覆盖全部整数。正式案例下文重算。",
        "图中38与40是规则类比：上界不够好，整支都不能改善已有纪录。"
      ]
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "先登记一个真实可行方案",
      "text": "收益是七倍甲加九倍乙。两倍甲加三倍乙至多十七，三倍甲加乙至多十四；产量非负。先登记零产量，收益零。",
      "ruleIds": [
        "branch-bound.initialize"
      ],
      "eventIds": [
        "0",
        "1"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "relax",
      "kind": "event",
      "title": "先求交点，再检查限制",
      "text": "允许小数后，两条资源边界交于甲约三点五七、乙三点二九。交点还必须逐条通过全部限制，包括非负要求，才有资格比较收益。",
      "ruleIds": [
        "branch-bound.relax"
      ],
      "eventIds": [
        "2",
        "3",
        "4",
        "5",
        "6"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "reject",
      "kind": "event",
      "title": "交点不等于可行点",
      "text": "另一个交点甲八点五、乙零。代入第二条资源，三乘八点五等于二十五点五，超过十四，必须排除。",
      "ruleIds": [
        "branch-bound.relax"
      ],
      "eventIds": [
        "14"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "calculation"
      ],
      "calculationKeys": [
        "x",
        "y",
        "lhs",
        "rhs"
      ]
    },
    {
      "id": "bound",
      "kind": "event",
      "title": "比较所有可行角点",
      "text": "可行角点收益中，五十四点五七最高，成为根分支上界。它允许小数，不能冒充已可生产的整数纪录。",
      "ruleIds": [
        "branch-bound.bound"
      ],
      "eventIds": [
        "27",
        "28",
        "29",
        "30"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "branch",
      "kind": "event",
      "title": "两支覆盖全部整数",
      "text": "甲含小数，拆成甲至多三和甲至少四。整数不可能落在三与四之间，因此两支不漏解。本版先查较低分支。",
      "ruleIds": [
        "branch-bound.incumbent",
        "branch-bound.branch"
      ],
      "eventIds": [
        "31",
        "32",
        "33"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "branch-b",
      "kind": "event",
      "title": "乙含小数也要拆分",
      "text": "在甲至多三这支，放松解是甲三、乙约三点六七。乙再拆成至多三和至少四，继续查前者。",
      "ruleIds": [
        "branch-bound.bound",
        "branch-bound.incumbent",
        "branch-bound.branch"
      ],
      "eventIds": [
        "79",
        "82",
        "83",
        "84"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "integer",
      "kind": "event",
      "title": "完整整数方案才能更新纪录",
      "text": "找到甲三、乙三，收益四十八。两项都是整数，更新可行纪录；已达到这支放松上界，无须再分。",
      "ruleIds": [
        "branch-bound.bound",
        "branch-bound.incumbent"
      ],
      "eventIds": [
        "160",
        "161",
        "162"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "improve",
      "kind": "event",
      "title": "更好的纪录来自真实整数解",
      "text": "后续甲二、乙四，先检验整数，再把可行纪录更新为五十。",
      "ruleIds": [
        "branch-bound.incumbent"
      ],
      "eventIds": [
        "478",
        "479"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "improve-again",
      "kind": "event",
      "title": "再次提升整数纪录",
      "text": "甲一、乙五又给出五十二。同样先检验再更新，没有四舍五入。",
      "ruleIds": [
        "branch-bound.incumbent"
      ],
      "eventIds": [
        "611",
        "612"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "infeasible",
      "kind": "event",
      "title": "没有方案的分支",
      "text": "这一支的连续放松已不可行。整数集合更小，也不可能可行，因此整支剪掉。",
      "ruleIds": [
        "branch-bound.prune"
      ],
      "eventIds": [
        "704"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "prune",
      "kind": "event",
      "title": "有方案，也可能不值得继续",
      "text": "另一支允许小数的最高收益只有四十六，不超过已有五十二。这次拒绝依据是不能改善，不是没有方案。",
      "ruleIds": [
        "branch-bound.prune"
      ],
      "eventIds": [
        "754"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "stop",
      "kind": "event",
      "title": "待查栈为空，证明才闭合",
      "text": "九个分支检查完，剪枝两支，待查栈为空。因此五十二已是全局最优，不只是目前最好。",
      "ruleIds": [
        "branch-bound.stop"
      ],
      "eventIds": [
        "755"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "recap",
      "kind": "recap",
      "title": "栈空才闭合最优证明",
      "text": "回放取分支、求上界、查整数，再选择登记、拆分或剪枝。每次放弃都保留理由。",
