{
  "algorithmId": "pso",
  "pronunciations": {
    "PSO": "粒子群"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "登山队共享最好地点",
      "text": "登山队每人记住自己找到的最高处，也听取全队最高处的消息。下一次滑行同时受原速度、个人记忆、团队记忆影响。粒子群把每个人当作一份参数方案，比较收益后更新记忆，反复寻找更好位置。",
      "ruleIds": [
        "pso.initialize",
        "pso.remember"
      ],
      "panelExplanations": [
        "旅行者的位置是一份参数方案，山高代表收益；不是横坐标越大越好。",
        "新的移动受原速度、个人最好位置与团队最好位置影响，三个方向可相反。",
        "新收益更高才更新历史纪录；本版发现后立即共享，不等全队移动结束。"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "先有评价，才知道谁最好",
      "text": "三个粒子初速度为零，个人最好先取各自初始位置。团队最好取最高收益，初始约三十五点八七；判断依据是收益，不是坐标大小。",
      "ruleIds": [
        "pso.initialize"
      ],
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "move",
      "kind": "event",
      "title": "下一步由三个分量相加",
      "text": "新速度等于惯性乘旧速度，再加朝个人最好和团队最好的两项牵引。每项牵引是位置差，乘一点五与独立随机数。第一粒子旧速度零、个人位置差零，只剩团队牵引，速度约六点五九。",
      "ruleIds": [
        "pso.move"
      ],
      "eventIds": [
        "1"
      ],
      "detailEventIds": [
        "1"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "remember-personal",
      "kind": "event",
      "title": "新收益先更新个人纪录",
      "text": "移动后收益约四十二点二九，超过个人纪录十点四二，先更新个人记忆。",
      "ruleIds": [
        "pso.remember"
      ],
      "eventIds": [
        "2"
      ],
      "detailEventIds": [
        "2"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "remember-team",
      "kind": "event",
      "title": "团队纪录也立即共享",
      "text": "新收益也超过团队纪录三十五点八七，因此团队记忆也更新。本版按粒子顺序即时共享，后面的粒子会使用刚刚更新的团队位置，而非等全队走完。",
      "ruleIds": [
        "pso.remember"
      ],
      "eventIds": [
        "3"
      ],
      "detailEventIds": [
        "3"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "worse",
      "kind": "event",
      "title": "第二粒子变差，为什么保留旧记忆",
      "text": "第二粒子移到新位置后，收益约负一点三三，低于个人纪录四点九三，也不如团队纪录，因此保留两份旧记忆。移动可以退步，历史最好不会跟着降低。",
      "ruleIds": [
        "pso.move",
        "pso.remember"
      ],
      "eventIds": [
        "4",
        "5",
        "6"
      ],
      "detailEventIds": [
        "5",
        "6"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "clip",
      "kind": "event",
      "title": "第三粒子为什么不能直接走二十四",
      "text": "第三粒子计算速度约负二十四点零八。本版限制速度在正负十八内，所以截为负十八；位置随后也限制在零到一百。",
      "ruleIds": [
        "pso.move",
        "pso.remember"
      ],
      "eventIds": [
        "7"
      ],
      "detailEventIds": [
        "7"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "compare",
      "kind": "event",
      "title": "不是朝最近的人跟跑",
      "text": "下一轮第二粒子的个人牵引向左、团队牵引向右，叠加惯性后仍向右。三个分量可能抵消或加强，绝不是朝最近同伴跟跑。两份记忆与当前位置相同且速度零时，各项全零，随机数不会凭空产生移动。",
      "ruleIds": [
        "pso.move"
      ],
      "eventIds": [
        "13"
      ],
      "detailEventIds": [
        "13"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ],
      "operandsPerPage": 4
    },
