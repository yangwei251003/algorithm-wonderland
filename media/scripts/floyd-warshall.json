{
  "algorithmId": "floyd-warshall",
  "pronunciations": {
    "Floyd–Warshall": "弗洛伊德沃舍尔"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "不断开放新的中转站",
      "text": "旅行服务台最初只知道直达票价。每允许一个新中转站，就为所有起终点问一次：不经过它的旧报价，和经过它的两段报价，哪个更低？这不是只寻找一条路线，而是逐步建立任意两站之间的最低费用表。",
      "ruleIds": [
        "floyd-warshall.initialize",
        "floyd-warshall.intermediate"
      ],
      "panelExplanations": [
        "初始只知直达票价。A到C没有直达边，暂记∞，不是负票价。",
        "允许B作新中转后，A→B与B→C两段相加8+6=14，比未知路线更好。",
        "以后允许D，候选7+11=18比14贵，所以保留旧值。旧中转仍可使用。"
      ]
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "初始表有什么依据",
      "text": "四个站之间，自身到自身记零，有直达边填费用，没有直达边暂记无穷。无穷不是零，也不是实际票价。本例甲到丙没有直达连接。",
      "ruleIds": [
        "floyd-warshall.initialize"
      ],
      "eventIds": [
        "0"
      ]
    },
    {
      "id": "outer",
      "kind": "event",
      "title": "本轮新增甲站中转",
      "text": "先允许甲站作中转，其他地点对都要检查。每轮只新增一个允许的中转点，已允许的仍能使用，不是只准经过一个站。",
      "ruleIds": [
        "floyd-warshall.intermediate",
        "floyd-warshall.compare"
      ],
      "eventIds": [
        "1"
      ],
      "detailEventIds": [
        "1"
      ]
    },
    {
      "id": "unreachable",
      "kind": "event",
      "title": "一段不可达，不能拼成路",
      "text": "看甲到丙经甲的候选：甲到甲是零，但甲到丙仍未知。有一段不可达，就不能得到有限报价，原记录保持无穷。",
      "ruleIds": [
        "floyd-warshall.intermediate",
        "floyd-warshall.compare"
      ],
      "eventIds": [
        "4"
      ],
      "detailEventIds": [
