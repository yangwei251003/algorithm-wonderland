  "beats": [
    {
      "id": "intro-value",
      "kind": "analogy",
      "title": "每个地点，每个方向，各记一份经验",
      "text": "每个地点、每个方向各记一个Q值，估计累计回报，不是成功概率。",
      "ruleIds": [
        "q-init"
      ],
      "panelExplanations": [
        "地点与方向共同索引一个Q值；它估计累计回报，不是成功概率。",
        "选择动作之后才得到奖励；到达、碰壁和普通移动反馈不同。",
        "把当前奖励与折扣后的未来估计合起来，只更新刚选动作。"
      ],
      "artworkRegion": [
        0.01,
        0.11,
        0.99,
        0.445
      ],
      "panelIndex": 0
    },
    {
      "id": "intro-reward",
      "kind": "analogy",
      "title": "行动以后，才看到奖励",
      "text": "行动以后才看到奖励。到达、碰壁和普通移动，反馈不同。",
      "ruleIds": [
        "q-init"
      ],
      "panelExplanations": [
        "地点与方向共同索引一个Q值；它估计累计回报，不是成功概率。",
        "选择动作之后才得到奖励；到达、碰壁和普通移动反馈不同。",
        "把当前奖励与折扣后的未来估计合起来，只更新刚选动作。"
      ],
      "artworkRegion": [
        0.345,
        0.455,
        0.68,
        0.75
      ],
      "panelIndex": 1
    },
    {
      "id": "intro-update",
      "kind": "analogy",
      "title": "用眼前奖励和未来估计，修正经验",
      "text": "更新时把眼前奖励和折扣后的未来估计合起来，只改刚做的那个动作分。",
      "ruleIds": [
        "q-init"
      ],
      "panelExplanations": [
        "地点与方向共同索引一个Q值；它估计累计回报，不是成功概率。",
        "选择动作之后才得到奖励；到达、碰壁和普通移动反馈不同。",
