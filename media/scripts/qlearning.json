    {
      "id": "initialize",
      "kind": "event",
      "title": "开始这一轮，位置回到起点",
      "text": "先把位置放回起点；Q表最初为零。",
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "choose",
      "kind": "event",
      "title": "第一次为什么选择向上？",
      "text": "本例每次有百分之二十五的机会随机探索，否则选当前Q值最大动作。第一次没有触发探索，四个Q值又全是零，于是按上、右、下、左的平局顺序选上。起点在左上角，这次越界，仍留在原格，奖励负一。",
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "rule",
        "comparison"
      ],
      "candidateTargets": [
        "上",
        "右"
      ],
      "stateView": "before"
    },
    {
      "id": "update",
      "kind": "event",
      "title": "负反馈怎样进入经验表？",
      "text": "旧Q为零，下一格最大Q也为零。新目标是负一加零点九三乘零，仍是负一。学习率零点三表示只朝这个目标移动百分之三十，所以本格向上的Q从零变成负零点三。",
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "Q旧",
        "r",
        "下一格最大Q",
        "α",
        "γ"
      ]
    },
    {
      "id": "choose-right",
      "kind": "comparison",
      "title": "第二步为什么改选右？",
      "text": "向上的Q已是负零点三，右仍为零，因此第二步改选右。",
      "eventIds": [
        "2"
      ],
      "detailEventIds": [
        "2"
      ],
      "pageModes": [
        "comparison"
      ],
      "candidateTargets": [
        "上",
        "右"
      ],
      "stateView": "before"
    },
    {
      "id": "alternative",
      "kind": "comparison",
      "title": "普通移动，更新另一个动作分",
      "text": "正常移动奖励负零点一五。旧Q和下一格最大Q都为零，更新成负零点零四五。碰壁和移动的反馈不同，动作分也不同。",
      "eventIds": [
        "2"
      ],
      "pageModes": [
