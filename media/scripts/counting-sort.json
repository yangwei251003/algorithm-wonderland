      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "summary",
      "kind": "summary",
      "title": "整数、范围和内存决定是否合适",
      "text": "小范围整数积分和离散等级适合分类计数。本版只重建数值，没有追踪同值记录身份，不能据此断言所有计数排序都不稳定。先看值域，再看可用内存。",
      "artwork": "../comics/counting-sort/summary.png",
      "artworkRegion": [
        0,
        0.678,
        1,
        0.918
      ],
      "panelExplanations": [
        "五次写回之外，还有扫描输入和计数盒的成本。数值重建版不演示带身份记录的稳定排列。"
      ],
      "ruleIds": [
        "counting-sort.stop"
      ]
    }
