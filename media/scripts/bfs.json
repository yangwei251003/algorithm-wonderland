  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "为什么先问近一层的人？",
      "text": "找朋友，先问直接认识的人。用待问名单：先登记先处理，新发现的排到末尾。一跳的人先于两跳的人被询问，这就是BFS。",
      "ruleIds": [
        "bfs.initialize",
        "bfs.select"
      ]
    },
    {
      "id": "initialize",
      "kind": "event",
      "title": "起点先登记",
      "text": "五乘五图，零号起点，二十四号终点。角标是编号，中间是步数。起点记零步，先进队列。每条边算一步。",
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "pop-zero",
      "kind": "event",
      "title": "取出队首零号",
      "text": "先从队首取出零号。先入先出，保证逐层处理。",
      "eventIds": [
        "1",
        "2"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "right-one",
      "kind": "event",
      "title": "检查右边一号",
      "text": "从零号检查右边：一号可达，距离零加一等于一，父节点记零号。",
      "eventIds": [
        "3"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "down-five",
      "kind": "event",
      "title": "检查下边五号",
      "text": "再查下边，五号也可达。记同样的一步，排到一号后面。",
      "eventIds": [
        "4"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "origin-bounds",
      "kind": "event",
      "title": "左边与上边为什么不走",
      "text": "然后查左、上，均越界，所以拒绝。固定方向决定同层先后，逐层扩散来自队列。",
      "eventIds": [
        "5",
        "6"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "pop-one",
      "kind": "event",
      "title": "为什么先处理一号",
