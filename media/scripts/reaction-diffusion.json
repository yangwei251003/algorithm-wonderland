    {
      "id": "calculation",
      "kind": "event",
      "title": "第一步一个格怎样改变",
      "text": "示例格的微浓度约零点二五九六，扩散项为负零点一四四的一半，反应增加约零点零三四七，移除约零点零二五四。合计新浓度约零点一九六九。每一个增减，都对应一项明确规则。",
      "eventIds": [
        "1"
      ],
      "ruleIds": [
        "reaction-update"
      ],
      "pageModes": [
