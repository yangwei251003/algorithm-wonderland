  },
  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "没有画笔，颜料也能长出花纹",
      "text": "想象细格纸里有两种颜料，一边向邻居渗开，一边互相转化，还不断补给和清走。没人预先画斑点，局部规则反复作用后却形成图案。反应扩散把这种想法写成每格浓度的更新账本。",
      "ruleIds": [
        "reaction-rule",
        "reaction-update"
      ],
      "panelExplanations": [
        "邻域扩散交换影响；均匀浓度的扩散项为零。",
        "反应量UV²：从U扣除，同量加入V。",
        "补给U，并按f+k移除V；全部格同步更新。"
      ]
    },
    {
      "id": "initial",
      "kind": "event",
      "title": "先放扰动，再约定怎样扩散",
      "text": "本例在四十八乘三十二格里，用固定种子放八个小斑块。每格扩散项由中心负一、四个正邻居各零点二、四个斜邻居各零点零五组成。权重总和零，因此完全均匀的浓度不会仅因扩散自己改变。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "reaction-rule"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "chemistry",
      "kind": "event",
      "title": "转化、补给、清走分别算",
      "text": "反应量等于物质优乘物质微的平方，它从优中扣除、加到微里。补给项把优往一拉，移除项把微带走。两种物质扩散速度不同，本例优系数一、微系数二分之一，边界循环连接。",
      "eventIds": [
        "1"
      ],
