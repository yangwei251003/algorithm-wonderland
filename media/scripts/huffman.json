      "pageModes": [
        "compact"
      ],
      "stateView": "after"
    },
    {
      "id": "size",
      "kind": "event",
      "title": "九位载荷，不等于完整文件",
      "text": "本格式码表含头共二十字节，九位载荷补齐为两字节。合计一百七十六位，反比原文四十八位大。小消息可能不划算。",
      "ruleIds": [
        "huffman.size"
      ],
      "eventIds": [
        "31"
      ],
      "pageModes": [
