      ]
    },
    {
      "id": "summary",
      "kind": "summary",
      "title": "最优前缀载荷，也要算格式开销",
      "text": "它适合长且频率不均的数据。同频可能产生不同合法码字，双方需共用码表；最优前缀载荷不保证完整文件更小。",
      "ruleIds": [
        "huffman.size"
      ]
    }
  ],
