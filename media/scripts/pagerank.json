{
  "algorithmId": "pagerank",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "网页上的随机散步",
      "text": "把网页想成展馆房间。访客通常随机走一扇门，偶尔跳去任意房间；没有出口也要回流。反复分配后，长期停留份额高的房间排名更高。",
      "ruleIds": [
        "pagerank.initialize"
      ],
      "visualExplanation": "房间对应网页，门对应有向链接；随机跳转与无出口回流都保证概率有去处。"
    },
    {
      "id": "init",
      "kind": "event",
      "title": "四页先各拿四分之一",
      "text": "四页初始各零点二五。沿链接概率零点八五，剩余零点一五随机跳转。完整一轮的总份额应保持一。",
      "ruleIds": [
        "pagerank.initialize"
      ],
      "eventIds": [
        "0"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "out",
      "kind": "event",
      "title": "先检查每个页面的出口",
      "text": "甲有两个出口，乙一个，丙两个。先记录出口数，之后沿边分配时必须用它来平分。",
      "ruleIds": [
        "pagerank.distribute"
      ],
      "eventIds": [
        "1",
        "2",
        "3"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "dangling",
      "kind": "event",
      "title": "丁没有出口，份额不能消失",
      "text": "丁没有出口，它的四分之一进入回流池。如果直接丢掉，下一轮概率总量就会少一块。",
      "ruleIds": [
        "pagerank.distribute"
      ],
      "eventIds": [
        "4"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "base",
      "kind": "event",
      "title": "所有页面共享两项基础份额",
      "text": "随机跳转每页零点零三七五，回流再给零点零五三一二五，相加零点零九零六二五。新账本先填这个数。",
      "ruleIds": [
        "pagerank.distribute"
      ],
      "eventIds": [
        "5"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "edge-a",
      "kind": "event",
      "title": "甲的份额分给两个出口",
      "text": "甲旧份额乘零点八五，再除以二，每边零点一零六二五。先给乙，再给丙；新账本分别累加。",
      "ruleIds": [
        "pagerank.distribute"
      ],
      "eventIds": [
        "6",
        "7"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "edge-b",
      "kind": "event",
      "title": "乙只有一条出链",
      "text": "乙沿链接的份额全部给丙，零点二五乘零点八五，得零点二一二五。虽同为一个入链，贡献不相等。",
      "ruleIds": [
        "pagerank.distribute"
      ],
      "eventIds": [
        "8"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "edge-c",
      "kind": "event",
      "title": "丙仍按旧份额分配",
      "text": "丙也分给两个出口。它本轮刚收到更多，不能立刻转出去；否则会因处理顺序不同改变算法。",
      "ruleIds": [
        "pagerank.distribute"
      ],
      "eventIds": [
        "9",
        "10"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "difference",
      "kind": "event",
      "title": "逐页比较新旧差距",
      "text": "整轮分配完，先看甲：新份额零点一九六八七五，与旧值相差零点零五三一二五。取绝对值，避免增减抵消。",
      "ruleIds": [
        "pagerank.stop"
      ],
      "eventIds": [
        "11"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "commit",
      "kind": "event",
      "title": "四项差距合计后再换账本",
      "text": "四页差距相加零点三一八七五，尚未稳定。整轮新账本才替换旧账本，进入下一轮。",
      "ruleIds": [
        "pagerank.stop"
      ],
      "eventIds": [
        "12",
        "13",
        "14",
        "15"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "repeat",
      "kind": "recap",
      "title": "每一轮重复同一分配规则",
      "text": "继续检查出口、均分基础份额、沿边传递，再比整轮变化。回放加速，所有计算仍有记录。",
