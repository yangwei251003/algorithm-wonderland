{
  "algorithmId": "genetic",
  "pronunciations": {
    "OX": "保序交叉"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "让旅行方案产生下一代",
      "text": "几份旅行路线中，较短者更有机会当家长。孩子复制片段、补齐城市，偶尔交换位置。选择、交叉、突变产生新方案，同时保护最好原件。",
      "ruleIds": [
        "genetic.initialize",
        "genetic.select"
      ],
      "panelExplanations": [
        "候选是每城一次并回起点的访问顺序；抽三份比较，较短者作为家长。",
        "复制一个父母片段，再按另一父母的相对顺序补齐未出现城市，跳过重复。",
        "交换位置只是变换；保留最好原件，防止探索破坏已找到的好方案。"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "先定义合法与好坏",
      "text": "本例四城、六候选、五代预算。每城一次、最后回起点，以整圈长度评价。初代最好约一百二十六点零九，先保留原件。",
      "ruleIds": [
        "genetic.initialize",
        "genetic.select"
      ],
      "eventIds": [
        "0",
        "1",
        "2"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "select",
      "kind": "event",
      "title": "抽三份比较，而不是遍历全部",
      "text": "每次选家长，随机抽三份，逐次保留较短者，同长保留先到者。第一次抽样中的路线同长，因此不换胜者；两次锦标赛分别产生两个家长。",
      "ruleIds": [
        "genetic.select"
      ],
      "eventIds": [
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ],
      "detailEventIds": [
        "4"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "cross",
      "kind": "event",
      "title": "先原位复制父甲片段",
      "text": "第一次保留父甲前两位，填入城市三、四。父母本次恰好同序；子代其余位置仍空，不能当成城市零。",
      "ruleIds": [
        "genetic.cross"
      ],
      "eventIds": [
        "9",
        "10",
        "11"
      ],
      "detailEventIds": [
        "10",
        "11"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "fill",
      "kind": "event",
      "title": "循环读取父乙，补尚未出现者",
      "text": "从父乙第三位开始循环，读到二、一尚未出现，依次补入空位，得到三、四、二、一。城市位置与城市编号是两件事。",
      "ruleIds": [
        "genetic.cross"
      ],
      "eventIds": [
        "12",
        "13"
      ],
      "detailEventIds": [
        "12",
        "13"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "skip",
      "kind": "event",
      "title": "再读到三和四，为什么跳过",
      "text": "接着又读到三与四，已在复制片段中，必须跳过。这样每城恰好一次；简单拼接可能重复城市并漏掉其他城市。",
      "ruleIds": [
        "genetic.cross"
      ],
      "eventIds": [
        "14",
        "15"
      ],
      "detailEventIds": [
        "14",
        "15"
      ],
      "pageModes": [
        "comparison"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "no-mutation",
      "kind": "event",
      "title": "本次抽签没有触发交换",
      "text": "抽签约零点九九七四，大于突变概率零点三，因此保留。算出子代长一百二十六点零九后，才加入下一代。",
      "ruleIds": [
        "genetic.mutate"
      ],
      "eventIds": [
        "16",
        "17"
      ],
      "detailEventIds": [
        "16"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "reject-long",
      "kind": "event",
      "title": "下一位孩子选父母时，拒绝长者",
      "text": "下一次抽样中，一百五十点九二比一百二十六点零九更长，保留较短者。赢的是本次样本中的路线，不一定是全种群最短。",
      "ruleIds": [
        "genetic.select"
      ],
      "eventIds": [
        "18",
        "19",
        "20"
      ],
      "detailEventIds": [
        "19"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "mutate",
      "kind": "event",
      "title": "后来的孩子抽中了交换",
      "text": "另一个孩子抽到零点一一一二，小于零点三，交换第二与第四位，仍保留所有城市。新路线仍需评价，交换本身不保证更短。",
      "ruleIds": [
        "genetic.mutate"
      ],
      "eventIds": [
        "47",
        "48"
      ],
      "detailEventIds": [
        "47"
      ],
      "pageModes": [
        "rule"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "compare",
      "kind": "comparison",
      "title": "较好父母也可能生出较差孩子",
      "text": "交叉保留访问顺序，未必保留短边；突变也可能拉长路线。精英原件不做破坏性修改，历史最好才不会丢失。新方案必须算整圈长度，不能看它发生变化就说改善。",
      "ruleIds": [],
      "operandsPerPage": 4
    },
