{
  "algorithmId": "kalman",
  "pronunciations": {
    "Kalman": "卡尔曼",
    "RMSE": "均方根误差"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "两种位置提醒，谁更可信？",
      "text": "走路时，你能按上次位置和步长估计自己在哪里，手机也给出一个位置。两者都有误差。卡尔曼滤波让这两种提醒合作。",
      "ruleIds": [
        "kalman-predict",
        "kalman-gain",
        "kalman-update"
      ],
      "panelExplanations": [
        "步长预测与手机测量都有误差；需要按可靠程度融合。"
      ],
      "artworkRegion": [
        0,
        0.12,
        0.67,
        0.66
      ]
    },
    {
      "id": "predict",
      "kind": "event",
      "title": "先预测位置，也预测不确定度",
      "text": "上次位置十，模型说前进零点四五，预测十点四五。方差五加过程方差零点一，变成五点一。横线表示中心两侧一个标准差，越宽越不确定，并非保证范围。",
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "旧位置",
        "旧方差",
        "Q",
        "预测位置"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "gain",
      "kind": "event",
      "title": "不确定度决定新证据的分量",
      "text": "测量标准差假定为六，平方以后方差是三十六。新测量的权重，等于五点一除以五点一加三十六，约零点一二四。这里预测比测量更可靠，所以新提醒只占约百分之十二点四。",
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "P预测",
        "R"
      ]
    },
    {
      "id": "reject-all",
      "kind": "event",
      "title": "为什么不直接跳到手机位置",
      "text": "完全相信测量，等于给它百分之百权重。但测量有噪声，不能只因更新鲜就全信。",
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "comparison"
      ],
      "candidateTargets": [
        "完全相信新测量"
      ]
    },
    {
      "id": "choose-weight",
      "kind": "event",
      "title": "为什么采用这个权重",
      "text": "固定各信一半，也没考虑可靠程度。这里按明确的方差公式分配权重。",
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "comparison"
      ],
      "candidateTargets": [
        "融合预测与测量"
      ]
    },
    {
      "id": "update",
      "kind": "event",
      "title": "先算要修正多少",
      "text": "新测量约八点六二，比预测十点四五低。相减后乘权重零点一二四，再加回预测，位置约十点二二三。",
      "eventIds": [
        "2"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "预测位置",
        "z",
        "K"
      ],
      "stateView": "before"
    },
    {
      "id": "save-variance",
      "kind": "event",
      "title": "保存融合位置和新的不确定度",
      "text": "现在写入新位置。同时，原预测方差五点一乘一减权重，变成约四点四六七，留给下一轮。",
      "eventIds": [
        "2"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "预测方差",
        "K",
        "新方差"
      ]
    },
    {
      "id": "second-predict",
      "kind": "event",
      "title": "第二轮先预测",
      "text": "第二轮从刚保存的位置再前进零点四五，方差再增加零点一。",
      "eventIds": [
        "3"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "second-gain",
      "kind": "event",
      "title": "第二轮重新计算信任",
      "text": "预测方差变了，新测量权重也重新算，约百分之十一点三。",
      "eventIds": [
        "4"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "second-update",
      "kind": "event",
      "title": "第二轮再融合",
      "text": "收到约三点五的新测量，只吸收对应比例的差距，得到约九点八六五。",
      "eventIds": [
        "5"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "repeat",
      "kind": "recap",
      "title": "第3—120次：同规则重复",
      "text": "加速回放第三到第一百二十次测量，重复预测、分配权重、修正。这里展示代表状态，全部计算可在网页逐步展开。",
