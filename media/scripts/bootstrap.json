{
  "algorithmId": "bootstrap",
  "pronunciations": {
    "Bootstrap": "自助重采样"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "只有一袋调查票，怎么办？",
      "text": "只有十、十二、十四、十六四份调查，平均值稳不稳？把票放进袋子，抽一张记数字，再放回。每袋抽满四次算一个均值，重复多袋，观察均值波动。",
      "ruleIds": [
        "bootstrap.initialize"
      ]
    },
    {
      "id": "init",
      "kind": "event",
      "title": "抽的是原始位置",
      "text": "原样本均值十三。四个位置各有四分之一概率。我们用样本代替总体，要求它适合代表关心的人群，也适合作为独立同分布观察。重抽不会增加真实调查。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "bootstrap.initialize"
      ]
    },
    {
      "id": "draw",
      "kind": "event",
      "title": "第一抽怎样选中十四？",
      "text": "第一个随机数约零点六零一一，乘四向下取整，索引是二，也就是第三张票十四。记录这个值，再放回原袋，下次四张票仍都有机会。",
      "eventIds": [
        "1"
      ],
      "ruleIds": [
        "bootstrap.resample"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "draw-two",
      "kind": "event",
      "title": "第二抽：十二",
      "text": "第二抽得到索引一、票值十二。加上上一张十四，累计和是二十六；二十六不是抽到的新票。",
      "eventIds": [
        "2"
      ],
      "ruleIds": [
        "bootstrap.resample"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "draw-three",
      "kind": "event",
      "title": "第三抽：十六",
      "text": "第三抽取索引三、票值十六，累计和变成四十二。原袋组成不变。",
      "eventIds": [
        "3"
      ],
      "ruleIds": [
        "bootstrap.resample"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "draw-four",
      "kind": "event",
      "title": "第四抽：十四再次出现",
      "text": "第四抽又得到索引二、十四。有放回，所以同一张可以重复。累计五十六。若拿走不放回，四次只是排列原袋，均值不会波动。",
      "eventIds": [
        "4"
      ],
      "ruleIds": [
        "bootstrap.resample"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "mean",
      "kind": "event",
      "title": "每袋只产出一个统计量",
      "text": "这袋十四、十二、十六、十四，合计五十六，除四得到均值十四。每袋只保存一个均值，下一袋再重新抽。",
      "eventIds": [
        "5"
      ],
      "ruleIds": [
        "bootstrap.resample"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
