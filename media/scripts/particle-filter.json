{
  "algorithmId": "particle-filter",
  "pronunciations": {
    "RMSE": "均方根误差"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "把可能的位置，保留成一把筹码",
      "text": "在陌生走廊里，把可能的位置各放一枚筹码。它们是同一位置的多种猜测，不是多个机器人。走一步，所有猜测按运动模型前进，也保留移动误差。看见地标以后，证据改变各个份额，再按份额复制，继续保留多种可能。",
      "ruleIds": [
        "particle-predict",
        "particle-weight",
        "particle-resample"
      ],
      "panelExplanations": [
        "每枚筹码代表一种位置假设；不是一个独立机器人。",
        "所有假设按运动模型前进；每个粒子还带有过程噪声。",
        "地标证据改变权重，再按累计份额重采样。"
      ]
    },
    {
      "id": "predict",
      "kind": "event",
      "title": "每个猜测都前进，也都允许误差",
      "text": "本例保留一百五十个粒子，每轮预计前进零点五，再给各自加一点运动噪声。第一枚从约六十点一一零出发，这次扰动约负零点一七五，所以预测到六十点四三五。所有移动都来自固定种子的真实抽样。",
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "weight",
      "kind": "event",
      "title": "用同一条测量，逐个检查相容程度",
      "text": "新测量约二十二点七二一，假定测量噪声标准差为四。对每个预测位置，先计算它应该产生什么测量，再把与新证据的差放入高斯误差模型。误差越小，通常获得越大权重，最后让全部份额之和等于一。",
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "compare",
      "kind": "rule",
      "title": "为什么同一条证据支持程度不同？",
      "text": "看两个真实候选。二十二点五九九非常接近新测量，归一化权重约百分之六点一五；六十点四三五离得很远，权重接近零。这里没有把远处候选宣布为绝对不可能，也没有把最大权重宣布为真实位置。",
      "artwork": "../comics/particle-filter/rules.png",
      "artworkRegion": [
        0.26,
        0.12,
        0.99,
        0.565
      ],
      "visualExplanation": "同一测量22.721：\n22.599附近权重约6.15%；\n60.435处接近零，但非绝对不可能。"
    },
    {
      "id": "sample",
      "kind": "event",
      "title": "按份额复制，而不是只选第一名",
      "text": "把权重排成累计份额，从零到一之间放入一百五十个等间隔指针。第一个偏移随机，后面每次加一除以一百五十。指针落到谁的区间，就复制谁的位置；区间更宽，通常获得更多副本。本版复制后还加少量抖动。",
      "eventIds": [
        "2"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "again",
      "kind": "recap",
      "title": "第2轮：同规则继续",
      "text": "下一轮用重采样后的粒子重新预测、加权、复制。不会只拿平均值去代替整堆猜测，旧粒子的位置与份额都实际参与计算。",
      "eventIds": [
        "3",
        "4",
        "5"
      ]
    },
    {
      "id": "repeat",
      "kind": "recap",
      "title": "第3—90轮，同规则重复",
      "text": "接下来加速回放第三到第九十轮，全部二百七十条阶段记录都能展开。本次唯一地标案例，最终统计的位置均方根误差约一点零三。指标来自估计与真实轨迹的比较，真实位置没有偷偷参与加权。",
