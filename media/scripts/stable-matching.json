    {
      "id": "summary",
      "kind": "summary",
      "title": "双向偏好的匹配工具",
      "text": "导师选择、项目组招募等双方都有偏好的场景，可先考虑稳定匹配。真实问题如果有名额、并列或不可接受对象，需要相应变体。按最高未试志愿申请，接收方只向更喜欢者换，落选者继续试。",
      "ruleIds": [
        "stable-matching.stop"
      ],
      "panelExplanations": [
        "本例最终配对：学生1—导师2、学生2—导师1、学生3—导师3；五次提议。",
        "匿名人物只是阻挡配对的定义示意：未搭配的双方都更想换到对方。本例没有这种配对。",
        "稳定不等于总满意度最高。完整无并列偏好、一对一是本版假设，其他条件需要变体。"
      ]
    }
  ]
