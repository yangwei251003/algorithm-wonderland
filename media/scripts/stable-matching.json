    {
      "id": "replace",
      "kind": "event",
      "title": "导师三为什么换人",
      "text": "学生三也申请导师三。导师三把学生三排第一，原搭配学生一排第三，所以留下更喜欢的学生三。学生一回到自由队列。只改变当前搭配，比较始终依据原来的偏好排名。",
      "ruleIds": [
        "stable-matching.propose",
        "stable-matching.choose"
      ],
      "eventIds": [
        "5",
        "6"
      ],
