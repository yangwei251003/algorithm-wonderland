{
  "algorithmId": "stable-matching",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "申请是暂时接受的过程",
      "text": "学生各有导师志愿，导师也有学生偏好。学生按志愿逐个申请，导师暂时保留最喜欢的申请者，以后收到更喜欢的人才替换。被拒者继续申请下一志愿。这套延迟接受规则追求的是稳定。",
      "ruleIds": [
        "stable-matching.initialize"
      ],
      "panelExplanations": [
        "学生1先申请导师3。空缺时先暂留，后续仍可以更换。",
        "导师3更喜欢学生3，于是保留学生3，让学生1重新成为自由申请者。",
        "学生1下一志愿是导师1。按固定志愿继续，不重试已经拒绝过的导师。"
      ]
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "完整偏好，没有并列",
      "text": "本例有三位学生和三位导师，双方都有完整、不并列的偏好。初始全部空缺，学生自由队列按编号排列，每人记录下一志愿，不重复申请已试对象。",
      "ruleIds": [
        "stable-matching.initialize"
      ],
      "eventIds": [
        "0"
      ]
    },
    {
      "id": "first",
      "kind": "event",
      "title": "空缺导师为何先答应",
      "text": "学生一先向导师三申请。导师三空缺，暂时接受。接受条件是尚无搭配，或者更喜欢新申请者；暂时接受并不永久锁定。",
      "ruleIds": [
        "stable-matching.propose",
        "stable-matching.choose"
      ],
      "eventIds": [
        "1",
        "2"
      ],
      "detailEventIds": [
