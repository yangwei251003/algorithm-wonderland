{
  "algorithmId": "crc",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "发送前补章，收到后重算",
      "text": "寄消息前，算一枚余数章。接收方重新核对，检查是否符合约定关系。就像带校验章的信件，但章不能告诉你哪里坏了，也不会修复。",
      "ruleIds": [
        "crc.initialize"
      ],
      "panelExplanations": [
        "发送方补余数章，接收方重新校验；发现不符合就拒绝，零余数也不是绝对没变的证明。"
      ]
    },
    {
      "id": "init",
      "kind": "event",
      "title": "预留三位给余数",
      "text": "数据一一零一，规则一零一一。规则长四位，最高次数三，末尾补三个零。七位工作串才是待除对象。",
      "ruleIds": [
        "crc.initialize"
      ],
      "eventIds": [
        "0"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "leading",
      "kind": "event",
      "title": "先看当前首位",
      "text": "从位置零开始，首位一，需要对齐规则来消去它；首位零就右移。这里算异或，相同得零，不同得一。",
      "ruleIds": [
        "crc.divide"
      ],
      "eventIds": [
        "1"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "first-xor",
      "kind": "event",
      "title": "第一对相同，消去最高位",
      "text": "第一对，一异或一得零，只改这一位。另外三位还没处理，不能跳到下个起点。",
      "ruleIds": [
        "crc.divide"
      ],
      "eventIds": [
        "2"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "old",
        "polynomialBit"
      ]
    },
    {
      "id": "next-xor",
      "kind": "recap",
      "title": "把对齐的四位全部处理完",
      "text": "逐位处理剩下三对。规则的零也参与核对，它会保留原位。没有借位或进位。",
      "ruleIds": [
        "crc.divide"
      ],
      "eventIds": [
        "3",
        "4",
        "5"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "repeat",
      "kind": "recap",
      "title": "右移起点，重复已讲的规则",
      "text": "后面三个起点重复同一规则。本例首位都是一，每次都对齐四位异或；工作串按记录逐位更新。",
      "ruleIds": [
        "crc.divide"
      ],
      "eventIds": [
