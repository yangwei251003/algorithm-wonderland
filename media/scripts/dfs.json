{
  "algorithmId": "dfs",
  "pronunciations": {
    "DFS": "深度优先搜索",
    "BFS": "广度优先搜索"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "带着一叠便签走迷宫",
      "text": "每到一个岔路，你都留张便签，记住哪些方向还没试。先沿一个未走过的方向深入；遇到死胡同，就退到上一张便签处继续试。",
      "ruleIds": [
        "dfs.initialize",
        "dfs.select"
      ],
      "panelExplanations": [
        "每个路口留下便签，记录来路与下一个未尝试方向，对应调用栈中的一帧。",
        "选定未访问的可走邻居，就先深入它；父路口未试方向暂时保留。",
        "死路时回到上一张便签继续。这是一般规则，本次成功路径没有实际死路退栈。"
      ]
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "方向顺序是一条明确约定",
      "text": "本例是四乘四网格，起点零，终点十五，五和九是障碍。我们约定按右、下、左、上的顺序检查邻居。每次只进入没有访问过的可走格，并记录它是从哪里来的。",
      "ruleIds": [
        "dfs.initialize",
        "dfs.neighbor"
      ],
      "eventIds": [
        "0",
        "1",
        "2"
      ]
    },
    {
      "id": "deep",
      "kind": "event",
      "title": "为什么连续走向右边",
      "text": "从零进入一后，先检查一的右侧，所以会继续深入二。父路口尚未尝试的方向留在栈里，暂不处理，直到当前分支结束。",
      "ruleIds": [
        "dfs.select",
        "dfs.neighbor"
      ],
      "eventIds": [
        "3",
        "4",
        "5"
      ],
      "detailEventIds": [
        "4"
      ],
      "pageModes": [
        "rule",
        "comparison",
        "compact"
      ]
    },
    {
      "id": "next-right",
      "kind": "event",
      "title": "同样规则，继续检查右侧",
      "text": "在二也先查右侧，进入三。每次发现新格就记来路并立即深入，没有同时把全部邻居扩散开。方向优先级决定了当前搜索顺序。",
      "ruleIds": [
        "dfs.select",
        "dfs.neighbor"
      ],
      "eventIds": [
        "6",
        "7"
      ],
      "detailEventIds": [
        "6"
      ],
      "pageModes": [
        "rule",
        "comparison",
        "compact"
      ]
    },
    {
      "id": "edge",
      "kind": "event",
      "title": "三的右边为什么拒绝",
      "text": "三的右边超出网格，因此拒绝；再按顺序检查下方七，它可走且未访问，便记录父节点三后进入。改方向有边界判断依据。",
      "ruleIds": [
        "dfs.select",
        "dfs.neighbor"
      ],
      "eventIds": [
        "8",
        "9",
        "10"
      ],
      "detailEventIds": [
        "8",
        "9"
      ]
    },
    {
      "id": "down",
      "kind": "event",
      "title": "到七和十一仍检查相同顺序",
      "text": "七与十一也先检查右边，都因越界被拒绝，再向下前进，直到十五。每个方向都经过检查，并不是看到终点就瞬间跳过去。",
      "ruleIds": [
        "dfs.select",
        "dfs.neighbor"
      ],
      "eventIds": [
        "11",
        "12",
        "13",
        "14",
        "15",
        "16"
      ],
      "detailEventIds": [
        "11",
        "14"
      ]
    },
    {
      "id": "stop",
      "kind": "event",
      "title": "命中目标后才停止深入",
      "text": "进入十五满足目标条件，可以结束。本例找到目标前没有死路。一般情况下，若所有方向都不能进入，就弹出栈帧退回父节点；全栈耗尽仍未命中，才报告不可达。",
      "ruleIds": [
        "dfs.stop",
        "dfs.select"
      ],
      "eventIds": [
        "17"
      ]
    },
    {
      "id": "back",
      "kind": "event",
      "title": "先读出目标的父节点",
      "text": "找到目标后，先读取十五的父节点十一。它记录初次进入十五的来路，能解释为什么回到十一，而不是临时另选一个几何上更近的格子。",
      "ruleIds": [
        "dfs.backtrack"
      ],
      "eventIds": [
        "18"
      ],
      "detailEventIds": [
        "18"
      ]
    },
    {
      "id": "reconstruct",
      "kind": "event",
      "title": "沿父指针逐步还原",
      "text": "继续追溯剩余父指针，橙色逐段标出已恢复的来路，直到起点。把逆序记录翻转才得到正向路线。这是整理已发现路径，与死路时退回搜索分支不同。",
      "ruleIds": [
        "dfs.backtrack"
      ],
      "eventIds": [
