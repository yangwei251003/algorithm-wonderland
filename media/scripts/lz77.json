      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "decode-first",
      "kind": "event",
      "title": "解码先照字面写A",
      "text": "解码先写A；空点尚未输出。",
      "ruleIds": [
        "lz77.decode"
      ],
      "eventIds": [
        "49"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "copy-first",
      "kind": "event",
      "title": "当前长度减距离，就是来源",
      "text": "第二条先复制一次：输出长度一减距离一，取位置零的A，追加到末尾。",
      "ruleIds": [
