      ]
    },
    {
      "id": "best-last",
      "kind": "event",
      "title": "长度六胜过五，写末条记录",
      "text": "六比五长，更新最好。",
      "ruleIds": [
        "lz77.token"
      ],
      "eventIds": [
        "47"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "record-last",
      "kind": "event",
      "title": "长度六胜过五，写末条记录",
      "text": "记录距离七、长度六；已到末尾，新字为空。",
      "ruleIds": [
        "lz77.token"
      ],
      "eventIds": [
