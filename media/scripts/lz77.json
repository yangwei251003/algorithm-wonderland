      ]
    },
    {
      "id": "distance-seven",
      "kind": "recap",
      "title": "回看七，逐字比到末尾",
      "text": "尝试距离七，继续逐字比较。不能因距离远就排除，首先看匹配有多长。",
      "ruleIds": [
        "lz77.search"
      ],
      "eventIds": [
        "41",
