{
  "algorithmId": "seam-carving",
  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "剪掉一条总损失较小的细带",
      "text": "想让花纹布变窄，先算一条从顶到底细带的总成本。每行选一个格，上下行最多左右错一格。找出连续且总损失最小的路径，剪完重算，再继续缩窄；布料只是亮度变化的类比。",
      "ruleIds": [
        "seam-energy",
        "seam-dp"
      ],
      "panelExplanations": [
        "先找整条连续路径的总损失，再下剪刀。",
        "每行一个格，相邻行列号最多相差1。",
        "删除改变邻居关系；下一条缝必须重算。"
      ]
    },
    {
      "id": "energy",
      "kind": "event",
      "title": "先说明什么叫不显眼",
      "text": "本例把左右亮度差的绝对值，加上下差的绝对值，作为能量。边界复制最近像素。第一格约零点四五。能量小只表示局部变化少，不保证人眼觉得它不重要。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "seam-energy"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "dp",
      "kind": "event",
      "title": "第2行列24：比较三个真实前驱",
      "text": "每格只看上一行左上、正上、右上三个前驱。这三格显示都约零点九，实际左上略小，选择列二十三；加本格零点九，约得一点八。保留完整精度比较，并记下前驱。",
      "eventIds": [
        "1"
      ],
      "ruleIds": [
        "seam-dp"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "本格能量",
        "最小前驱代价"
      ]
    },
    {
      "id": "rows",
      "kind": "recap",
      "title": "同规则重复：逐行算到最底",
      "text": "其余行按相同递推加速回放。累计代价包含整条上游路径，不是只找每行最小能量；否则各点可能无法连接，或把后面逼进高代价区域。每格记录前驱，用于找回完整路线。",
      "eventIds": [
