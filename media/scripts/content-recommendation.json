        "28",
        "29"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "choose",
      "kind": "event",
      "title": "从全部候选中选最大",
      "text": "星际救援约零点九八一，高于其余六部，因此排第一。同分保留输入顺序较早者，不用影片名决定相似度。",
      "ruleIds": [
        "content-recommendation.choose"
      ],
      "eventIds": [
        "29"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "comparison"
      ],
      "maxCandidates": 3
    },
    {
      "id": "contrast",
      "kind": "comparison",
      "title": "把偏好同时翻倍会怎样",
      "text": "把三个偏好同时乘二，点积乘二，偏好长度也乘二，两者抵消，余弦不变。只提高幽默则改变方向，排序才可能变化。零向量没有方向，不能正常计算余弦。",
      "ruleIds": []
    },
    {
      "id": "summary",
      "kind": "summary",
      "title": "它理解的是标签，不是你本人",
      "text": "对齐标签，累计乘积与平方和，除以长度，再比较相似度。适合有标签的新物品；标签遗漏的特点看不到。相似度不等于喜欢概率，也不等于作品质量，仍需真实反馈。",
      "ruleIds": [
        "content-recommendation.choose"
      ],
      "visualExplanation": "漫画对应标签可解释、新物品可用、漏标与零偏好的局限；本例最高的是星际救援。"
    }
  ]
