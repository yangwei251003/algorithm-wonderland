{
  "algorithmId": "content-recommendation",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "给口味画一支方向箭头",
      "text": "用冒险、幽默、科学三个旋钮表达口味，电影也用同样标签。像比较两支箭头，内容推荐看方向是否接近，不只看数值总和。",
      "ruleIds": [
        "content-recommendation.initialize"
      ],
      "visualExplanation": "旋钮对应三维偏好，箭头只示意比例；实际计算保留三个维度，不把三维夹角冒充画面中的二维角度。"
    },
    {
      "id": "init",
      "kind": "event",
      "title": "先把三种标签对齐",
      "text": "偏好为四、二、五，标签顺序和尺度必须一致。数值是教学标注，不是对作品的客观评分。",
      "ruleIds": [
        "content-recommendation.initialize"
      ],
      "eventIds": [
        "0"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "adventure",
      "kind": "event",
      "title": "第一项：冒险贡献",
      "text": "星际救援的标签为五、一、五。先看冒险，四乘五得二十；两边各自平方，分别是十六和二十五。",
      "ruleIds": [
        "content-recommendation.cosine"
      ],
      "eventIds": [
        "1"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "humor",
      "kind": "event",
      "title": "第二项：幽默贡献",
      "text": "幽默二乘一得二，累计点积从二十变二十二。平方和也各自增加四和一，不能把两列混加。",
      "ruleIds": [
        "content-recommendation.cosine"
      ],
      "eventIds": [
        "2"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "science",
      "kind": "event",
      "title": "第三项：科学贡献",
      "text": "科学五乘五得二十五，点积合计四十七。三个维度完成后，偏好平方和四十五，影片平方和五十一。",
      "ruleIds": [
        "content-recommendation.cosine"
      ],
      "eventIds": [
        "3"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "normalize",
      "kind": "event",
      "title": "为什么还要除以长度",
      "text": "四十七除以四十五乘五十一的平方根，得到约零点九八一。归一化去掉整体长度的影响，留下方向相似程度。",
      "ruleIds": [
        "content-recommendation.cosine"
      ],
      "eventIds": [
        "4"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "calculation"
      ]
    },
    {
      "id": "second-dimensions",
      "kind": "event",
      "title": "另一部重新累计",
      "text": "欢乐假期标签一、五、零。对齐同样的三维逐项相乘、累计；不能沿用上一部的分子和影片长度。",
      "ruleIds": [
        "content-recommendation.cosine"
      ],
      "eventIds": [
        "5",
        "6",
        "7"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "second-score",
      "kind": "event",
      "title": "相似更低，不是质量更差",
      "text": "这一部点积十四，影片平方和二十六，余弦约零点四零九。它偏幽默，与当前冒险和科学较强的方向差得更远。",
      "ruleIds": [
        "content-recommendation.cosine"
      ],
      "eventIds": [
        "8"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "recap",
      "kind": "recap",
      "title": "完整记录加速回放",
      "text": "回放七部影片的全部计算。每部独立归一化后才能公平比较，动画速度不表示推荐质量。",
      "ruleIds": [
        "content-recommendation.initialize",
        "content-recommendation.cosine",
        "content-recommendation.choose"
      ],
      "eventIds": [
