{
  "algorithmId": "minimax",
  "pronunciations": {
    "Minimax": "最小最大"
  },
  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "让对手也有选择权",
      "text": "我方先选路，对手再选终点。左路五和负二，对手选负二；右路一和三，对手选一。倒推选右路：对手取小，我方取大。",
      "ruleIds": [
        "minimax-branch"
      ],
      "panelExplanations": [
        "类比示意：我方先选岔路，对手再选终点。",
        "左路保住−2；右路保住1。对手也会认真选择。",
        "回到我方起点：max(−2,1)=1，选择右路。"
      ]
    },
    {
      "id": "leaf",
      "kind": "event",
      "title": "真实终局先评分",
      "text": "轮到叉，深度九。第三格落叉连成一行，剩八层，得一百加八，等于一百零八。越早赢分越高，输局取负，平局为零。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "minimax-leaf"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "branch",
      "kind": "event",
      "title": "换一个候选第一步",
      "text": "再试第六格。轮到圈，从空格选。父盘和各条假想分支分开显示。",
      "eventIds": [
        "1"
      ],
      "ruleIds": [
        "minimax-branch"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "descend",
      "kind": "recap",
      "title": "先往下展开，暂不猜分",
      "text": "沿分支向下：圈下第三格，叉下第七格，圈下第八格。未到叶子，暂不填回传分。",
      "eventIds": [
        "2",
        "3",
        "4"
      ],
      "ruleIds": [
        "minimax-branch"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "draw",
      "kind": "event",
      "title": "第九格填满，真实平局",
      "text": "叉再下第九格，满盘却无人连成三子，是真实平局。叶子值零，不是凭空猜的。",
      "eventIds": [
        "5"
      ],
      "ruleIds": [
        "minimax-leaf"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "return",
      "kind": "event",
      "title": "把叶子的零搬回上一层",
      "text": "上一层轮到叉，只有第九格可走。唯一子值零，取最大仍是零，沿箭头回传。",
      "eventIds": [
        "6"
      ],
      "ruleIds": [
        "minimax-branch"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "equal",
      "kind": "recap",
      "title": "另一条路也回传零",
      "text": "换另一分支，叶子仍为平局。",
      "eventIds": [
        "7",
        "8",
        "9"
      ],
      "ruleIds": [
        "minimax-branch"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "equal-min",
      "kind": "event",
      "title": "圈把两个零取最小",
      "text": "两个零回到圈的节点，取最小还是零；同分用较小格号。",
      "eventIds": [
        "10"
      ],
      "ruleIds": [
        "minimax-branch"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "threat",
      "kind": "event",
      "title": "换到有输赢差别的节点",
      "text": "现在叉先下第八格，圈可选第七或第九格。比较的是同一个父局面下两种未来。",
      "eventIds": [
        "11"
      ],
      "ruleIds": [
        "minimax-branch"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "loss",
      "kind": "event",
      "title": "第七格让圈立即连线",
      "text": "圈下第七格，右上到左下三个圈连线。叉输了，剩余深度五，得负一百零五。",
      "eventIds": [
        "12"
      ],
      "ruleIds": [
        "minimax-leaf"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "alternative",
      "kind": "recap",
      "title": "第九格则允许叉逼平",
      "text": "圈若改下第九格，叉补第七格可平局。这一终盘与已算状态相同，复用零再往上回传。",
      "eventIds": [
        "13",
        "14",
        "15"
      ],
      "ruleIds": [
        "minimax-branch"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "min",
      "kind": "event",
      "title": "对手把较小的值传回来",
      "text": "两条子值负一百零五和零。圈会选更小的负一百零五，让叉吃亏。箭头搬回的是保证值，不是已经落了那颗棋。",
      "eventIds": [
        "16"
      ],
      "ruleIds": [
        "minimax-branch"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
