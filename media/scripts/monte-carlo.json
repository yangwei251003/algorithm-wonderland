{
  "algorithmId": "monte-carlo",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "给明天做许多次排练",
      "text": "活动能在一百一十分钟内准备好吗？把明天提前排练很多遍：为四道工序抽可能耗时，按顺序相加，再数多少遍赶得上。蒙特卡洛把难算的概率变成随机实验。",
      "ruleIds": [
        "monte-carlo.initialize"
      ]
    },
    {
      "id": "init",
      "kind": "event",
      "title": "先规定怎样的明天可能出现",
      "text": "基准耗时是二十五、三十五、二十和三十分钟。假设工序串行、相互独立。每道用两个独立均匀数，相加减一，得到三角波动，再乘百分之三十幅度。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "monte-carlo.initialize"
      ]
    },
    {
      "id": "one",
      "kind": "event",
      "title": "第一道工序怎样抽出来？",
      "text": "第一对随机数约零点六零一一和零点四四八三，相加略大于一。代入模型，第一道比基准稍慢，耗时约二十五点三七。这是抽样计算，不是任意数字。",
      "eventIds": [
        "1"
      ],
      "ruleIds": [
        "monte-carlo.sample"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ],
      "operandsPerPage": 4
    },
    {
      "id": "stage-two",
      "kind": "event",
      "title": "工序2：继续累加",
      "text": "第二道重新抽数，得到四十点四八分钟。接在第一道之后，累计约六十五点八五。",
      "eventIds": [
        "2"
      ],
      "ruleIds": [
        "monte-carlo.sample"
      ],
      "pageModes": [
        "calculation"
      ]
    },
    {
      "id": "stage-three",
      "kind": "event",
      "title": "工序3：仍是串行",
      "text": "第三道约十八点二一分钟，接着累加，达到八十四点零六。",
      "eventIds": [
        "3"
      ],
      "ruleIds": [
        "monte-carlo.sample"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "stage-four",
      "kind": "event",
      "title": "工序4：这遍抽样完成",
      "text": "第四道约二十九点零八分钟，总共一百一十三点一四。四道依次进行，所以求和，不能取最大值。",
      "eventIds": [
        "4"
      ],
      "ruleIds": [
        "monte-carlo.sample"
      ],
      "pageModes": [
        "compact"
      ]
    },
    {
      "id": "test",
      "kind": "event",
      "title": "怎样判断这遍成功？",
      "text": "总耗时超过截止一百一十分钟，这遍不计成功。只有小于或等于截止才算按时。一次失败不能宣布活动一定来不及。",
      "eventIds": [
        "5"
      ],
      "ruleIds": [
        "monte-carlo.evaluate"
      ],
      "pageModes": [
        "rule",
        "calculation"
      ],
      "operandsPerPage": 4
    },
    {
