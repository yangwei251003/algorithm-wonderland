{
  "algorithmId": "kruskal",
  "pronunciations": {
    "Kruskal": "克鲁斯卡尔"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "省下重复连通的路",
      "text": "村庄修路，希望全部互通且总建设费最低。道路从便宜到贵看，跨不同村群才修，已互通就拒绝成环。这求的是整体基础网络。",
      "ruleIds": [
        "kruskal.initialize",
        "kruskal.choose"
      ],
      "panelExplanations": [
        "道路的数字是建设费用。全体村庄互通、总建设费最低，是当前目标。",
        "两端不在同一连通村群时加入道路，再合并两组。",
        "已经同组意味着另有道路相连；继续修会形成圈，所以拒绝。"
      ]
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "先排序，每个村自成组",
      "text": "五村各自一组，道路费用排序为三、六、七、八、八、九、十一。同费用按原输入顺序。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "kruskal.initialize"
      ],
      "pageModes": [
        "rule"
      ]
    },
