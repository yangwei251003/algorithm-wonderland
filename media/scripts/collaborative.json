{
  "algorithmId": "collaborative",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "借别人的共同观影经验",
      "text": "你没看过一部电影，怎么猜会不会喜欢？先借其他观众的共同评分，比较电影是否相近，再结合你对相近电影的评分。这是物品协同推荐。",
      "ruleIds": [
        "collaborative.initialize"
      ],
      "visualExplanation": "共同观众提供物品相似度；你自己的评分用于最后加权。电影海报只做类比，内容标签不参与。"
    },
    {
      "id": "init",
      "kind": "event",
      "title": "零是没评，不是差评",
      "text": "本例你已评三部，另三部等待预测。只用两部都评过的观众，不把零当成讨厌。",
      "ruleIds": [
        "collaborative.initialize"
      ],
      "eventIds": [
        "0"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule"
      ]
    },
    {
