      "title": "一位共同观众贡献什么",
      "text": "先比较星际远行和银河漫游。观众一给五分和四分，乘积二十；平方二十五和十六，分别累计。",
      "ruleIds": [
        "collaborative.similarity"
      ],
      "eventIds": [
        "1"
      ],
      "operandsPerPage": 4,
      "pageModes": [
        "rule",
        "comparison"
      ]
    },
