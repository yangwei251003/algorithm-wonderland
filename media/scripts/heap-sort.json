{
  "algorithmId": "heap-sort",
  "beats": [
    {
      "id": "intro-parent",
      "kind": "analogy",
      "title": "家长不小于孩子",
      "text": "把数字放上父子奖牌架，每位家长都不小于孩子。顺着父子关系往上，最大者一定在根。",
      "ruleIds": [
        "heap-sort.heap"
      ],
      "artwork": "../comics/heap-sort/analogy.png",
      "artworkRegion": [
        0,
        0.11,
        1,
        0.373
      ],
      "panelExplanations": [
        "7不小于5和1；5不小于3和2。父子大小保证根最大，并不保证整排有序。"
      ]
    },
    {
      "id": "intro-finish",
      "kind": "analogy",
      "title": "先把冠军送到队尾",
      "text": "把冠军七和末尾二交换，七留在完成区。新的根二不合格，还要修复。",
      "ruleIds": [
        "heap-sort.heap"
      ],
      "artwork": "../comics/heap-sort/analogy.png",
      "artworkRegion": [
        0,
        0.381,
        1,
        0.645
      ],
      "panelExplanations": [
        "本格是取出冠军后的瞬间：7已归位，2进入根；剩余树尚待修复。"
      ]
    },
    {
      "id": "intro-repair",
      "kind": "analogy",
      "title": "让较大的孩子上升",
      "text": "比较父子，让较大孩子上升，直到剩余架子重新合格，再选下一位冠军。",
      "ruleIds": [
        "heap-sort.heap"
      ],
      "artwork": "../comics/heap-sort/analogy.png",
      "artworkRegion": [
