    {
      "id": "best",
      "kind": "event",
      "title": "阈值82为什么胜过之前",
      "text": "阈值八十二时，暗组一千一百七十九个，均值约四十六点三八九；亮组三百五十七个，均值约一百八十六点七三四。人数乘积乘均值差平方，得到约八十二点九亿，比旧最好更大，于是记录八十二。",
      "eventIds": [
        "82"
      ],
      "ruleIds": [
        "otsu-score"
      ],
      "pageModes": [
        "calculation"
      ],
      "detailEventIds": [
