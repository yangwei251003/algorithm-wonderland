{
  "algorithmId": "otsu",
  "pronunciations": {
    "Otsu": "大津法"
  },
  "beats": [
    {
      "id": "analogy",
      "kind": "analogy",
      "title": "试一道门槛，把两队尽量分开",
      "text": "按身高分两队，可以试着移动门槛，看看两队人数和平均身高差。每个候选门槛都要试；空组没有均值，应跳过。大津法把身高换成像素亮度，寻找分离评分最大的阈值，最后用同一道门槛处理全图。",
      "ruleIds": [
        "otsu-score"
      ],
      "panelExplanations": [
        "身高只是类比：用一道门槛分两组。",
        "枚举候选，比较人数与均值差；空组跳过。",
        "身高对应像素亮度，分界线对应全图统一阈值。"
      ]
    },
    {
      "id": "empty",
      "kind": "event",
      "title": "一队没人，为什么不能评分",
      "text": "本例尝试八位灰度的零到二百五十五。阈值零时，没有像素进入暗组，全部一千五百三十六个都在亮组。空组没有可比较的平均亮度，因此跳过评分，不把空组的显示占位数字当成真实均值。",
      "eventIds": [
        "0"
      ],
      "ruleIds": [
        "otsu-empty"
      ],
      "pageModes": [
        "calculation"
      ],
      "calculationKeys": [
        "暗组数",
        "亮组数"
      ]
    },
