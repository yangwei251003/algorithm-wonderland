{
  "algorithmId": "reservoir",
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "队伍多长还不知道",
      "text": "报名者陆续出现，总人数未知，却只能保留三个名额。蓄水池抽样只保存三个样本，通过适时替换，让每位已到达的人拥有相同的入选概率。",
      "ruleIds": [
        "reservoir.draw"
      ],
      "artwork": "../comics/reservoir/analogy.png",
      "artworkRegion": [
        0,
        0.091,
        1,
        0.347
      ],
      "panelExplanations": [
        "三个固定席位对应三个样本槽；不储存全部报名者，也不用预知最终人数。"
      ]
    },
    {
      "id": "fill",
      "kind": "event",
      "title": "先填满三个固定槽",
      "text": "席位编号零、一、二。最初三位报名者先全部进入，不需要抽签。槽内数字表示人的编号，不是人数或概率。",
      "eventIds": [
        "0",
        "1",
        "2"
      ],
      "ruleIds": [
        "reservoir.fill",
        "reservoir.draw",
        "reservoir.stop"
