    {
      "id": "finish",
      "kind": "summary",
      "title": "数邻居，再决定能否接力",
      "text": "适合空间聚集和离群点探索，无须预先定组数。但统一半径可能难兼顾不同密度，单位也会改变邻居，共享边界的归属还可能受访问顺序影响。",
      "ruleIds": [
        "dbscan.neighborhood",
        "dbscan.classify",
        "dbscan.expand"
      ],
      "visualExplanation": "核心点能接力，边界点不能。正式七点案例得到一个组与三个噪声点。"
    }
  ]
