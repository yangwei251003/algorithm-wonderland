{
  "algorithmId": "dijkstra",
  "pronunciations": {
    "Dijkstra": "迪杰斯特拉"
  },
  "beats": [
    {
      "id": "intro",
      "kind": "analogy",
      "title": "每个路口一本最低账",
      "text": "配送走得近不一定费用低。每个路口记一本从起点出发的最低总账，先处理总账最小的待办项，再尝试更新邻居。",
      "ruleIds": [
        "dijkstra.initialize",
        "dijkstra.select"
      ],
      "panelExplanations": [
        "右侧路口报价9、下侧报价1，比较累计费用，不是格数或朝向。",
        "从全部待办项选当前总账最小者。报价9只是等待，未被永久淘汰。",
        "新报价14高于原记录12，保留旧记录与父节点；更新依据是两份累计费用的比较。"
      ]
    },
    {
      "id": "setup",
      "kind": "event",
      "title": "起点零，其他尚未知",
      "text": "起点花费零，其他暂记无穷，表示路线未知。候选先只有起点，取出它以后检查邻居。",
      "ruleIds": [
        "dijkstra.initialize",
        "dijkstra.select",
        "dijkstra.neighbor"
      ],
      "eventIds": [
        "0",
        "1",
        "2"
      ],
      "detailEventIds": [],
      "pageModes": [
        "rule",
        "compact"
      ]
    },
    {
      "id": "right",
      "kind": "event",
      "title": "向右报价九",
      "text": "进入右侧一号格需要九，加起点零，得到新账九，小于未知的无穷，所以登记一号格，父节点记零。",
      "ruleIds": [
        "dijkstra.initialize",
        "dijkstra.select",
        "dijkstra.neighbor"
      ],
      "eventIds": [
        "3"
      ],
      "detailEventIds": [
        "3"
      ]
    },
    {
      "id": "down",
      "kind": "event",
      "title": "向下报价一",
      "text": "进入下方四号格只需一，新账零加一等于一，也小于无穷，登记它并记录来路。候选现在有一号格九、四号格一。",
      "ruleIds": [
        "dijkstra.initialize",
        "dijkstra.select",
        "dijkstra.neighbor"
      ],
      "eventIds": [
        "4"
      ],
      "detailEventIds": [
        "4"
      ]
    },
    {
      "id": "choose",
      "kind": "event",
      "title": "为什么先处理四号格",
      "text": "候选总账一小于九，因此取四号格。一号格只延后。边费用非负，尚未处理的更贵节点不可能绕回来改成更小的距离。",
      "ruleIds": [
        "dijkstra.select",
        "dijkstra.neighbor"
      ],
      "eventIds": [
        "7",
        "8"
      ],
      "detailEventIds": [
        "7"
      ]
    },
    {
      "id": "eight-wall",
      "kind": "event",
      "title": "先检查右侧障碍",
      "text": "右侧五号是墙，不能通过。",
      "ruleIds": [
        "dijkstra.neighbor"
      ],
      "eventIds": [
        "9"
      ],
      "pageModes": [
        "rule"
      ]
    },
    {
      "id": "eight",
      "kind": "event",
      "title": "四到八怎样得到二",
      "text": "再从四向下到八，累计一加边费一得二，比无穷小，更新来路。",
      "ruleIds": [
        "dijkstra.neighbor"
      ],
      "eventIds": [
